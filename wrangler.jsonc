// Cloudflare Workers serves the static pages built into dist/client, and runs
// api/index.ts for the API under /api/*, the on-demand Harness and ring card
// pages and the sitemap (run_worker_first), the cron triggers and the job
// queue. `astro build` bundles the script with the Astro adapter and writes
// the deployable config to dist/server/wrangler.json, which `wrangler deploy`
// picks up.
//
// Pushes to main are built and deployed by Cloudflare, which does not migrate
// D1: apply new migrations first with `pnpm db:migrate:remote`. `pnpm run
// deploy` does both from this machine.
{
  "name": "official-website",
  "main": "./api/index.ts",
  "compatibility_date": "2026-10-06",
  // Better Auth keeps per-request state in AsyncLocalStorage
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // unknown addresses get 404.html, with a 404 status
    "not_found_handling": "404-page",
    // Everything else is a file, served without running the script. Pages
    // rendered on demand must be listed here, or they get the 404 page (and
    // in ON_DEMAND in api/index.ts, for `astro dev`).
    // Authorization HTML is rendered by the Worker only (no-store, no
    // framing), never placed in assets, so a path alias that misses these
    // rules finds no copy of it there.
    "run_worker_first": ["/api/*", "/authorize*", "/zh/authorize*", "/harness", "/harness/*", "/zh/harness", "/zh/harness/*", "/ring/*", "/zh/ring/*", "/sitemap.xml", "/sitemap-harness-*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spacering",
      "database_id": "614d6988-d884-4329-b252-425fab92a776",
      "migrations_dir": "db/migrations"
    },
    // The Harness catalog, apart from the accounts: its search index (FTS5)
    // cannot be exported, its imports must not queue ahead of sign-ins, and it
    // can be rebuilt from its sources while the accounts cannot.
    {
      "binding": "HARNESS_DB",
      "database_name": "harness",
      "database_id": "8ce376fc-d4b4-4363-9f61-218965fd8f81",
      "migrations_dir": "db/harness"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "spacering-media"
    },
    // Harness files by content hash: blobs/, archives/, and later readme/,
    // icons/ and uploads/ (uploads/ expires after a day, a bucket lifecycle rule)
    {
      "binding": "HARNESS_FILES",
      "bucket_name": "spacering-harness"
    }
  ],
  // Harness imports and checks run here, one job per invocation and two at a
  // time, away from requests. A failed job is retried a minute later, five
  // times, then parked in the dead-letter queue.
  "queues": {
    "producers": [{ "binding": "HARNESS_JOBS", "queue": "harness-jobs" }],
    "consumers": [
      {
        "queue": "harness-jobs",
        "max_batch_size": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "max_concurrency": 2,
        "dead_letter_queue": "harness-jobs-dlq"
      }
    ]
  },
  // A skill repository is unpacked, checked and packed in one job, which can
  // take more than the default 30 seconds of CPU: allow the most there is.
  "limits": { "cpu_ms": 300000 },
  "ratelimits": [
    // sign-in endpoints write to the database: a few dozen requests a minute per address
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    // anonymous Harness reads, per address
    {
      "name": "HARNESS_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 }
    },
    // ring card pictures rendered (not those served from the cache), per address
    {
      "name": "RING_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    },
    // Codeg's client API and the connection list, per address. Generous: a
    // Codeg Web instance calls for all its users from one address. Anonymous
    // traffic is counted here, never with writes to the accounts database.
    {
      "name": "CLIENT_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 300, "period": 60 }
    },
    // Anonymous Codeg sign-in steps (new request, page lookup, code
    // exchange), per address and step; Web clients are counted per client.
    {
      "name": "CLIENT_FLOW_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // which deployment this is: pages kept at the edge are kept per deployment,
  // since each names the assets of the build that rendered it (api/harness/cache.ts)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "SITE_URL": "https://spacering.net",
    // The model review of Harness versions (docs: section 7). Off: versions are
    // listed on the strength of the rule checks alone.
    "HARNESS_REVIEW": "off",
    // Plugins take their skills and assistants off the shelves (docs/harness-plugins.md,
    // sections 10 and 11). Off: plugins are only reachable by their address, and
    // their members stay items of their own. A switch also needs every source reconciled.
    "HARNESS_PLUGINS": "on"
  },
  "triggers": {
    // daily: clear expired sign-in states and sessions, refresh Harness skill
    // repos and recount facets; hourly: Harness registry sync (api/index.ts)
    "crons": ["23 3 * * *", "17 * * * *"]
  },
  // Codeg sign-in keeps request IDs, codes and tokens out of every URL SRN
  // receives (fragment, request bodies), so request logs need no exception.
  "observability": {
    "enabled": true
  }
}
