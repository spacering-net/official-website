{
  "name": "spacering-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "spacering.net official website",
  "scripts": {
    "dev": "astro dev",
    "dev:api": "astro build && wrangler dev --port 8787",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types api/worker-configuration.d.ts",
    "check": "astro sync && tsc --noEmit && tsc -p api",
    "qa:shots": "node scripts/shoot.mjs",
    "qa:modes": "node scripts/check-modes.mjs",
    "qa:nav": "node scripts/check-nav.mjs",
    "qa:menu": "node scripts/check-menu.mjs",
    "qa:fit": "node scripts/check-fit.mjs",
    "qa:jump": "node scripts/check-jump.mjs",
    "qa:switch": "node scripts/check-switch.mjs",
    "qa:perf": "node scripts/perf.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.5",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
