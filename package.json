{
  "name": "spacering-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "spacering.net official website",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "pnpm db:migrate:remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local -c wrangler.jsonc && wrangler d1 migrations apply HARNESS_DB --local -c wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc && wrangler d1 migrations apply HARNESS_DB --remote -c wrangler.jsonc",
    "cf-typegen": "wrangler types api/worker-configuration.d.ts -c wrangler.jsonc --strict-vars=false",
    "check": "astro sync && tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "node --import ./tests/harness/register.mjs --test \"tests/*/*.test.mjs\"",
    "qa:shots": "node scripts/shoot.mjs",
    "qa:modes": "node scripts/check-modes.mjs",
    "qa:nav": "node scripts/check-nav.mjs",
    "qa:menu": "node scripts/check-menu.mjs",
    "qa:fit": "node scripts/check-fit.mjs",
    "qa:jump": "node scripts/check-jump.mjs",
    "qa:switch": "node scripts/check-switch.mjs",
    "qa:pages": "node scripts/check-pages.mjs",
    "qa:perf": "node scripts/perf.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@jsquash/jpeg": "1.6.0",
    "@resvg/resvg-wasm": "2.6.2",
    "astro": "^7.3.5",
    "better-auth": "^1.7.7",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "lenis": "^1.3.26",
    "markdown-it": "^15.0.2",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.147.0"
  },
  "resolutions": {
    "sharp@<0.35.5": "0.35.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
