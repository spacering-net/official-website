---
/**
 * Text pages (privacy policy, terms): a column of prose in the site's frame
 * (layouts/Page.astro). Each has a twin in the other language.
 */
import Page from './Page.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** this page's path under each language, e.g. { en: '/privacy/', zh: '/zh/privacy/' } */
  paths: Record<Lang, string>;
  updated: string;
}
const { lang, title, description, paths, updated } = Astro.props;
const label = lang === 'en' ? 'Last updated' : '最后更新';
---
<Page lang={lang} title={`${title} · SpaceRing`} description={description} paths={paths}>
  <article class="wrap doc">
    <h1>{title}</h1>
    <p class="updated">{label}: {updated}</p>
    <slot />
  </article>
</Page>

<style>
  /* on the column's left edge, under the HUD's brand, a line of prose wide */
  .doc {
    padding-top: var(--s-6);
    line-height: 1.75;
    color: var(--corona-80);
  }

  .doc > :global(*) {
    max-width: 44rem;
  }

  h1 {
    font-size: clamp(30px, 5vw, 42px);
    font-weight: 300;
    line-height: 1.2;
    color: var(--corona);
  }

  .updated {
    margin: var(--s-4) 0 var(--s-6);
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--graphite);
  }

  .doc :global(h2) {
    margin: var(--s-6) 0 var(--s-3);
    font-size: 19px;
    font-weight: 500;
    color: var(--corona);
  }

  .doc :global(p),
  .doc :global(ul) {
    margin: 0 0 var(--s-4);
  }

  .doc :global(ul) {
    padding-left: 1.2em;
    list-style: disc;
  }

  .doc :global(li) {
    margin-bottom: var(--s-2);
  }

  .doc :global(a) {
    color: var(--bead);
    text-decoration: underline;
    text-decoration-color: rgb(var(--bead-rgb) / 0.4);
    text-underline-offset: 3px;
  }
</style>
