---
/**
 * Harness pages: rendered on demand by the Worker, standalone and light, with
 * no scene and no intro, in the site's type and colours. Each has a twin in
 * the other language.
 */
import '@fontsource-variable/jost';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Logo from '../components/Logo.astro';
import { SITE } from '../config';
import { harnessDicts } from '../i18n/harness';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** this page in each language, with its query */
  paths: Record<Lang, string>;
  /** search results and later pages are not for search engines */
  noindex?: boolean;
}
const { lang, title, description, paths, noindex } = Astro.props;
const h = harnessDicts[lang];
const other = harnessDicts[h.other];
const base = lang === 'en' ? '/' : '/zh/';
const canonical = `${SITE.url}${paths[lang]}`;
---
<!doctype html>
<html lang={h.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="en" href={`${SITE.url}${paths.en}`} />
    <link rel="alternate" hreflang="zh-CN" href={`${SITE.url}${paths.zh}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE.url}${paths.en}`} />
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SpaceRing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={base} aria-label={h.home}><Logo class="mark" /><span aria-hidden="true">SpaceRing</span></a>
      <a class="section" href={h.base}>Harness</a>
      <a class="lang" href={paths[h.other]} hreflang={other.htmlLang} lang={other.htmlLang} aria-label={h.switchLabel}>{h.switchName}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bottom">
      <a href={`${base}privacy/`}>{h.footer.privacy}</a>
      <a href={`${base}terms/`}>{h.footer.terms}</a>
      <a href="/api/harness/v1/openapi.json">API</a>
      <span>© {new Date().getFullYear()} SpaceRing · spacering.net</span>
    </footer>
  </body>
</html>

<!-- global: shared by every Harness page and its components -->
<style is:global>
  :root {
    --void: #050507;
    --corona: #eceaf4;
    --bead: #ffd9a0;
    --ion: #9adfff;
    --prominence: #ff6f86;
    --graphite: #8b8a99;
    --line: rgb(236 234 244 / 0.1);
    --dim: rgb(236 234 244 / 0.64);
    --mono: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
  }

  body {
    margin: 0;
    background: var(--void);
    color: rgb(236 234 244 / 0.86);
    font-family: 'Jost Variable', 'Jost', 'PingFang SC', 'HarmonyOS Sans SC', 'Microsoft YaHei', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .top,
  main,
  .bottom {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 21px;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 21px;
    height: 89px;
  }

  .top a,
  .bottom a {
    color: var(--dim);
    text-decoration: none;
    transition: color 0.3s;
  }

  .top a:hover,
  .bottom a:hover {
    color: var(--corona);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--corona) !important;
  }

  .mark {
    width: 28px;
    height: 28px;
    fill: var(--corona);
  }

  .section {
    padding-left: 21px;
    border-left: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bead) !important;
  }

  .lang {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  main {
    padding-top: 21px;
    padding-bottom: 89px;
    min-height: 60vh;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 13px 21px;
    padding-top: 21px;
    padding-bottom: 34px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--graphite);
  }

  .bottom span {
    margin-left: auto;
  }

  h1,
  h2,
  h3 {
    color: var(--corona);
    font-weight: 400;
    line-height: 1.2;
  }

  a {
    color: var(--bead);
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible {
    outline: 1px solid var(--bead);
    outline-offset: 3px;
  }

  .mono {
    font-family: var(--mono);
    font-size: 0.8125em;
    letter-spacing: 0.02em;
  }

  .muted {
    color: var(--graphite);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 1px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--dim);
    white-space: nowrap;
  }

  .badge.kind {
    color: var(--bead);
    border-color: rgb(255 217 160 / 0.3);
  }

  .badge.risk-medium {
    color: var(--bead);
    border-color: rgb(255 217 160 / 0.5);
  }

  .badge.risk-high {
    color: var(--prominence);
    border-color: rgb(255 111 134 / 0.5);
  }

  .badge.listed {
    color: var(--ion);
    border-color: rgb(154 223 255 / 0.35);
  }

  @media (max-width: 640px) {
    .top {
      height: 72px;
      gap: 13px;
    }

    .brand span {
      display: none;
    }

    .section {
      padding-left: 13px;
    }
  }
</style>
