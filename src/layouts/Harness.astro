---
/**
 * Harness pages: the catalog in the site's frame (layouts/Page.astro),
 * rendered on demand by the Worker. Everything works with plain links and
 * forms; client/harness.ts adds in-page search and filtering, loading more,
 * copying, and the item page's section bar.
 */
import Page from './Page.astro';
import '../styles/harness.css';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** this page in each language, with its query */
  paths: Record<Lang, string>;
  /** search results and later pages are not for search engines */
  noindex?: boolean;
}
const { lang, title, description, paths, noindex } = Astro.props;
---
<Page lang={lang} title={title} description={description} paths={paths} noindex={noindex} current="harness">
  {/* without scripts: filters stay on the page instead of in a sheet, and nothing waits for a script to show it */}
  <noscript slot="head"><style>.browse__side { display: block !important; } [data-sheet-open] { display: none !important; }</style></noscript>
  <slot />
  <script>
    import '../client/harness';
  </script>
</Page>
