---
import '@fontsource-variable/jost';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/site.css';
import '../styles/home.css';
import type { Dict } from '../i18n';
import { SITE } from '../config';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const canonical = new URL(t.path, SITE.url).href;
---
<!doctype html>
<html lang={t.htmlLang} class="is-intro" data-scramble={t.scramble}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${SITE.url}/`} />
    <link rel="alternate" hreflang="zh-CN" href={`${SITE.url}/zh/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE.url}/`} />
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SpaceRing" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/${t.lang === 'zh' ? 'og-zh' : 'og'}.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {/*
      Inline on purpose: Chrome can check the view-transition opt-in before the
      stylesheet arrives (a pointer resting on the page forces an early style
      pass), and would then drop the cross-fade between the language pages.
      The old page stays up (vt-hold) until the new one has drawn a frame.
    */}
    <style is:inline>
      @view-transition { navigation: auto; }
      ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 0.45s; animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1); }
      html.vt-hold::view-transition-old(root), html.vt-hold::view-transition-new(root) { animation-play-state: paused; }
    </style>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (/[?&]capture\b/.test(location.search)) d.classList.add('capture');
        try {
          var p = location.pathname;
          var saved = localStorage.getItem('sr-lang');
          var pref = saved || (/^zh/i.test(navigator.language || '') ? 'zh' : 'en');
          if (pref === 'zh' && (p === '/' || p === '/index.html')) {
            location.replace('/zh/' + location.search + location.hash);
            return;
          }
        } catch (e) {}
        // Arriving from a language switch: the other page handed its scene over
        // (see main.ts). Skip the intro and keep the old page on screen until
        // this one has drawn its first frame; the timers are only a safety net.
        var h = null;
        try {
          h = JSON.parse(sessionStorage.getItem('sr-handoff') || 'null');
          sessionStorage.removeItem('sr-handoff');
        } catch (e) {}
        if (h && h.at <= Date.now() && Date.now() - h.at < 6000) {
          window.__srHandoff = h;
          d.classList.remove('is-intro');
          d.classList.add('is-handoff', 'vt-hold', 'handoff-fade');
          setTimeout(function () { d.classList.remove('vt-hold'); }, 1500);
          setTimeout(function () { d.classList.remove('is-handoff'); }, 2500);
        } else h = null;
        // The cross-fade is for language switches; any other arrival cuts.
        addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return;
          if (h) d.classList.remove('handoff-fade');
          else e.viewTransition.skipTransition();
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
