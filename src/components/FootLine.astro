---
/**
 * The last line of a page's foot: the languages and the theme on the left,
 * the small print on the right. The same at the foot of every page but the
 * homepage (SiteFooter.astro), of the narrow screens' menu (NavSheet.astro)
 * and of the console. Where it has too little room for one line (by its own
 * width, not the window's: the console's column is narrower than the page),
 * the small print goes under the rest, from the left, its two links kept
 * together on a line of their own if the whole does not fit.
 */
import LangSwitch from './LangSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
  /** this page in the other language (by default, that language's homepage) */
  alternate?: string;
  class?: string;
}
const { t, alternate, class: className } = Astro.props;
---
<div class:list={['foot-line', className]}>
  <div class="foot-line__prefs">
    <LangSwitch t={t} href={alternate} />
    <ThemeSwitch t={t} />
  </div>
  <p class="foot-line__legal">
    <span>© {new Date().getFullYear()} SpaceRing · spacering.net</span>
    <span class="foot-line__links">
      <a href={`${t.path}privacy/`}>{t.open.privacy}</a>
      <a href={`${t.path}terms/`}>{t.open.terms}</a>
    </span>
  </p>
</div>

<style>
  .foot-line {
    container: foot-line / inline-size;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
  }

  .foot-line__prefs {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .foot-line__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2) var(--s-5);
    margin-left: auto;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--graphite);
  }

  .foot-line__links {
    display: inline-flex;
    gap: var(--s-5);
    white-space: nowrap;
  }

  .foot-line__legal a {
    transition: color 0.3s;
  }

  .foot-line__legal a:hover {
    color: var(--corona);
  }

  @container foot-line (max-width: 620px) {
    .foot-line__prefs,
    .foot-line__legal {
      flex-basis: 100%;
    }

    .foot-line__legal {
      justify-content: flex-start;
      margin-left: 0;
    }
  }
</style>
