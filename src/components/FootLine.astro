---
/**
 * The last line of a page's foot: the languages (and, where a page offers
 * it, the theme) on the left, the small print on the right. The same at the
 * foot of every page but the homepage (SiteFooter.astro) and of the orbit
 * menu, the homepage's included.
 */
import LangSwitch from './LangSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
  /** this page in the other language (by default, that language's homepage) */
  alternate?: string;
  /** the theme switch: not on the homepage, which stays dark */
  theme?: boolean;
  class?: string;
}
const { t, alternate, theme = true, class: className } = Astro.props;
---
<div class:list={['foot-line', className]}>
  <div class="foot-line__prefs">
    <LangSwitch t={t} href={alternate} />
    {theme && <ThemeSwitch t={t} />}
  </div>
  <p class="foot-line__legal">
    <span>© {new Date().getFullYear()} SpaceRing · spacering.net</span>
    <a href={`${t.path}privacy/`}>{t.open.privacy}</a>
    <a href={`${t.path}terms/`}>{t.open.terms}</a>
  </p>
</div>

<style>
  .foot-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
  }

  .foot-line__prefs {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .foot-line__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2) var(--s-5);
    margin-left: auto;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--graphite);
  }

  .foot-line__legal a {
    transition: color 0.3s;
  }

  .foot-line__legal a:hover {
    color: var(--corona);
  }

  @media (max-width: 760px) {
    .foot-line {
      flex-direction: column;
      align-items: flex-start;
    }

    .foot-line__legal {
      justify-content: flex-start;
      margin-left: 0;
    }
  }
</style>
