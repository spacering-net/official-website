---
/**
 * The five kinds of asset Space holds, each as a line glyph on a 24 grid. Links
 * are two of the mark's ellipses (b/a = cos 30°) hooked together; memory is
 * the menu button's orbit with its node, the asset only your ring holds.
 */
import type { AssetKind } from '../../i18n/pages';

interface Props {
  kind: AssetKind;
}
const { kind } = Astro.props;
---
<svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {kind === 'files' && <path d="M6.5 3.5h7l4 4v13h-11zM13.5 3.5v4h4"></path>}
  {kind === 'photos' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
      <circle cx="9" cy="10" r="1.6"></circle>
      <path d="M3.5 16.5l4.6-3.8 3.4 2.8 3.2-2.6 5.8 4.6"></path>
    </>
  )}
  {kind === 'notes' && <path d="M5.5 6.5h13M5.5 10.5h13M5.5 14.5h13M5.5 18.5h7"></path>}
  {kind === 'links' && (
    <>
      <ellipse cx="9.2" cy="12.8" rx="5.6" ry="4.85" transform="rotate(-30 9.2 12.8)"></ellipse>
      <ellipse cx="14.8" cy="11.2" rx="5.6" ry="4.85" transform="rotate(-30 14.8 11.2)"></ellipse>
    </>
  )}
  {kind === 'memory' && (
    <>
      <ellipse cx="12" cy="12" rx="8.4" ry="7.27" transform="rotate(30 12 12)"></ellipse>
      <circle cx="8.37" cy="18.3" r="1.9" fill="currentColor" stroke="none"></circle>
    </>
  )}
</svg>
