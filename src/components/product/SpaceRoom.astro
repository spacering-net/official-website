---
/**
 * Space's drawing, "bigger on the inside": the SpaceRing mark, and through its
 * opening a room that never ends. The room is the opening itself, again and
 * again, each copy 1/φ the size of the last, shrinking towards the far rim's
 * centre: the ring's own axis. The copies sink one step every few seconds and
 * fade as they go, so the room keeps opening up; each carries one asset, set
 * the golden angle on from the one before, and memory (what your assistant
 * learns about you) is the warm one.
 *
 * Geometry is the mark's (components/mark.ts, the logo's construction): on its
 * 512 canvas the opening is the near rim's inner edge, 172.89 × 149.73 turned
 * 30° about O; the far rim lies √5u (u = 20) further along the minor axis.
 */
import { MARK_BAND, MARK_CRESCENT } from '../mark';

const PHI = (1 + Math.sqrt(5)) / 2;
const GOLDEN = Math.PI * (3 - Math.sqrt(5));
const TURN = Math.PI / 6;
const O = { x: 267.04, y: 236.65 };
const A = 172.89;
const B = 149.73;
// along the minor axis, from the near rim to the far one (and on to the mark's node)
const AXIS = { x: -Math.sin(TURN), y: Math.cos(TURN) };
const F = { x: +(O.x + AXIS.x * Math.sqrt(5) * 20).toFixed(2), y: +(O.y + AXIS.y * Math.sqrt(5) * 20).toFixed(2) };
const ellipse = (c: { x: number; y: number }) => ({ cx: c.x, cy: c.y, rx: A, ry: B, transform: `rotate(30 ${c.x} ${c.y})` });

/** a point on the opening, at angle t round it */
const onOpening = (t: number) => {
  const x = A * Math.cos(t);
  const y = B * Math.sin(t);
  return { x: +(O.x + x * Math.cos(TURN) - y * Math.sin(TURN)).toFixed(2), y: +(O.y + x * Math.sin(TURN) + y * Math.cos(TURN)).toFixed(2) };
};

// Seven copies of the opening; without motion, each rests half a step in.
const KINDS = ['files', 'photos', 'notes', 'memory', 'links', 'photos', 'files'] as const;
const STEPS = KINDS.length;
const fade = (d: number) => (d < 0.5 ? d / 0.5 : Math.max(0, 1 - (d - 0.5) / (STEPS - 0.5)));
const rings = KINDS.map((kind, k) => ({
  k,
  kind,
  at: onOpening(k * GOLDEN - Math.PI / 3),
  scale: +Math.pow(PHI, -(k + 0.5)).toFixed(4),
  opacity: +fade(k + 0.5).toFixed(3),
}));
// the symmetry axis, through O, the far rim's centre and the node, beyond the band
const axis = { x1: 397.04, y1: 11.48, x2: 117.04, y2: 496.46 };
---
<svg class="room" viewBox="0 0 512 512" style={`--vp:${F.x}px ${F.y}px;--steps:${STEPS}`}>
  <defs>
    {/* the room shows through both rims: inside the near one (the band covers the rest) and the far one */}
    <clipPath id="room-far"><ellipse {...ellipse(F)}></ellipse></clipPath>
    {/* glass, lit from the top left as the homepage's ring is */}
    <linearGradient id="room-glass" gradientUnits="userSpaceOnUse" x1="90" y1="70" x2="420" y2="470">
      <stop offset="0" style="stop-color:var(--corona);stop-opacity:0.2"></stop>
      <stop offset="1" style="stop-color:var(--corona);stop-opacity:0.03"></stop>
    </linearGradient>
    <linearGradient id="room-wall" gradientUnits="userSpaceOnUse" x1="140" y1="140" x2="420" y2="320">
      <stop offset="0" style="stop-color:var(--corona);stop-opacity:0.3"></stop>
      <stop offset="1" style="stop-color:var(--corona);stop-opacity:0.06"></stop>
    </linearGradient>
  </defs>
  <line class="room__axis" {...axis}></line>
  <g clip-path="url(#room-far)">
    {rings.map((r) => (
      <g class="room__ring" style={`--k:${r.k};transform:scale(${r.scale});opacity:${r.opacity}`}>
        <ellipse {...ellipse(O)}></ellipse>
        <circle class:list={['room__asset', r.kind === 'memory' && 'room__asset--memory']} cx={r.at.x} cy={r.at.y} r="7"></circle>
      </g>
    ))}
  </g>
  <path class="room__band" fill-rule="evenodd" d={MARK_BAND}></path>
  <path class="room__band room__band--wall" d={MARK_CRESCENT}></path>
</svg>

<style>
  .room__axis {
    stroke: rgb(var(--corona-rgb) / 0.18);
    stroke-width: 1;
    stroke-dasharray: 14 3 2 3;
  }

  /* each copy of the opening sinks towards the far rim's centre, φ smaller a step */
  .room__ring {
    transform-box: view-box;
    transform-origin: var(--vp);
    animation: room-sink calc(var(--steps) * 6s) cubic-bezier(0.333, 0.42, 0.667, 0.741) infinite;
    animation-delay: calc(var(--k) * -6s);
  }

  .room__ring ellipse {
    fill: none;
    stroke: rgb(var(--corona-rgb) / 0.62);
    stroke-width: 1.2;
  }

  .room__asset {
    fill: var(--void);
    stroke: rgb(var(--corona-rgb) / 0.8);
    stroke-width: 1.4;
  }

  .room__asset--memory {
    fill: var(--bead);
    stroke: none;
    filter: drop-shadow(0 0 6px var(--bead-glow));
  }

  /* the band as glass: a faint fill, its edges drawn, the node a hole through it */
  .room__band {
    fill: url(#room-glass);
    stroke: rgb(var(--corona-rgb) / 0.42);
    stroke-width: 1;
  }

  .room__band--wall {
    fill: url(#room-wall);
  }

  /* Off screen, it waits (client/product.ts); with reduced motion, each copy rests where it is drawn. */
  :global(.is-paused) .room__ring {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .room__ring {
      animation: none !important;
    }
  }

  /* one step every 6 s; the scale eases within each step, so the room sinks at an even pace */
  @keyframes room-sink {
    0% {
      transform: scale(1);
      opacity: 0;
    }
    7.1429% {
      opacity: 1;
    }
    14.2857% {
      transform: scale(0.618034);
      opacity: 0.92;
    }
    28.5714% {
      transform: scale(0.381966);
      opacity: 0.77;
    }
    42.8571% {
      transform: scale(0.236068);
      opacity: 0.62;
    }
    57.1429% {
      transform: scale(0.145898);
      opacity: 0.46;
    }
    71.4286% {
      transform: scale(0.09017);
      opacity: 0.31;
    }
    85.7143% {
      transform: scale(0.055728);
      opacity: 0.15;
    }
    100% {
      transform: scale(0.034442);
      opacity: 0;
    }
  }
</style>
