---
/**
 * The end of a product page: the ring itself, as the homepage's scene draws it
 * (the ring card's still, public/ring-card/art-1200.jpg), with what to do
 * next. Night in either theme, as the still is.
 */
interface Props {
  title: string;
  text: string;
}
const { title, text } = Astro.props;
---
<section class="closing">
  <img class="closing__art" src="/ring-card/art-1200.jpg" alt="" width="1200" height="630" loading="lazy" decoding="async" />
  <div class="closing__body">
    <h2 class="closing__title">{title}</h2>
    <p class="closing__text">{text}</p>
    <div class="closing__actions"><slot /></div>
  </div>
</section>

<style>
  /* the night palette, whatever the page's theme: the still is a night sky */
  .closing {
    --void: #050507;
    --corona: #eceaf4;
    --bead: #ffd9a0;
    --bead-hot: #fff4e2;
    --graphite: #8b8a99;
    --corona-80: rgb(236 234 244 / 0.8);
    --corona-64: rgb(236 234 244 / 0.64);
    --hairline-strong: rgb(236 234 244 / 0.2);
    --bead-rgb: 255 217 160;
    --btn-hover: #fff;
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(360px, 36vw, 520px);
    margin-top: var(--s-8);
    border: 1px solid rgb(236 234 244 / 0.1);
    border-radius: 21px;
    overflow: hidden;
    background: #050507;
    color: var(--corona);
    color-scheme: dark;
    isolation: isolate;
  }

  /* the ring on the right; the starfield on the left, darkened, under the words */
  .closing__art {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 50%;
  }

  .closing::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(5 5 7 / 0.82) 0%, rgb(5 5 7 / 0.55) 38%, rgb(5 5 7 / 0) 62%);
    pointer-events: none;
  }

  /* the words keep to the left half, clear of the ring */
  .closing__body {
    max-width: min(32rem, 50%);
    padding: var(--s-7);
  }

  .closing__title {
    font-size: clamp(28px, 3.1vw, 42px);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  :global(html:lang(zh-CN)) .closing__title {
    line-height: 1.3;
    letter-spacing: 0;
  }

  .closing__text {
    margin-top: var(--s-4);
    color: var(--corona-80);
    text-wrap: pretty;
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  /* narrower: the words over the dark top, the ring below them */
  @media (max-width: 960px) {
    .closing {
      align-items: start;
      min-height: 0;
    }

    /* the starfield rises out of the dark under the words */
    .closing__art {
      position: relative;
      inset: auto;
      grid-row: 2;
      height: auto;
      aspect-ratio: 16 / 9;
      object-position: 76% 50%;
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 34%);
      mask-image: linear-gradient(180deg, transparent, #000 34%);
    }

    .closing::after {
      display: none;
    }

    .closing__body {
      grid-row: 1;
      max-width: 36rem;
      padding: var(--s-7) var(--s-7) 0;
    }
  }

  @media (max-width: 760px) {
    .closing {
      margin-top: var(--s-7);
      border-radius: 13px;
    }

    .closing__art {
      aspect-ratio: 5 / 4;
      object-position: 80% 50%;
    }

    .closing__body {
      padding: var(--s-6) var(--s-5) 0;
    }
  }
</style>
