---
/**
 * "In the ring": how the other parts of the ring work with this page's
 * product, each a link to its own page, or to its chapter on the homepage
 * while it has none. Set like the orbit menu's list.
 */
import { PAGES, type Dict } from '../../i18n';
import type { RingPart } from '../../i18n/pages';

interface Props {
  t: Dict;
  title: string;
  lede: string;
  items: { key: RingPart; text: string }[];
}
const { t, title, lede, items } = Astro.props;
const parts = items.map(({ key, text }) => {
  const item = t.menu.items.find((i) => i.key === key)!;
  const own = PAGES[key as keyof typeof PAGES];
  return { key, text, name: item.name, status: item.status, href: own ? `${t.path}${own}` : `${t.path}#${key}` };
});
---
<section class="section">
  <div class="section__head">
    <h2 class="section__title">{title}</h2>
    <p class="section__lede">{lede}</p>
  </div>
  <ul class="parts">
    {parts.map((part) => (
      <li>
        <a class="part" href={part.href}>
          <span class="part__name">{part.name}</span>
          <span class="part__text">{part.text}</span>
          <span class:list={['part__status', 'mono', 'status', part.status === 'live' && 'status--live']}>{t.status[part.status]}</span>
          <svg class="part__go" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .parts {
    border-top: 1px solid var(--hairline-strong);
  }

  .parts li {
    border-bottom: 1px solid var(--hairline);
  }

  .part {
    display: grid;
    grid-template-columns: minmax(10rem, 17rem) minmax(0, 1fr) 7.5rem 16px;
    align-items: baseline;
    gap: var(--s-2) var(--s-6);
    padding: var(--s-5) 0;
  }

  .part__name {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--corona);
    transition:
      color 0.3s,
      translate 0.5s var(--ease-out);
  }

  .part__text {
    color: var(--corona-64);
    text-wrap: pretty;
  }

  .part__status {
    font-size: 10.5px;
    justify-self: start;
  }

  .part__go {
    align-self: center;
    width: 16px;
    height: 16px;
    color: var(--graphite);
    transition:
      color 0.3s,
      translate 0.35s var(--ease-out);
  }

  .part:hover .part__name,
  .part:focus-visible .part__name {
    color: var(--bead-hot);
    translate: 8px 0;
  }

  .part:hover .part__go,
  .part:focus-visible .part__go {
    color: var(--corona);
    translate: 3px 0;
  }

  @media (max-width: 760px) {
    .part {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-2) var(--s-4);
      padding: var(--s-4) 0;
    }

    .part__name {
      font-size: 24px;
    }

    .part__text {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .part__status {
      grid-column: 2;
      grid-row: 1;
    }

    .part__go {
      display: none;
    }
  }
</style>
