---
/**
 * Light, dark, or as the system is: for every page but the homepage, which
 * stays dark. Hidden until a script can switch (client/page.ts); the choice
 * is applied before a page's first paint (client/theme.js).
 */
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
  class?: string;
}
const { t, class: className } = Astro.props;
const options = [
  { value: 'light', label: t.theme.light },
  { value: 'dark', label: t.theme.dark },
  { value: 'system', label: t.theme.system },
] as const;
---
<div class:list={['theme', className]} role="group" aria-label={t.theme.label} data-theme-switch hidden>
  {options.map((o) => (
    <button class="theme__opt" type="button" data-theme-set={o.value} aria-pressed="false" aria-label={o.label} title={o.label}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
        {o.value === 'light' && (
          <>
            <circle cx="8" cy="8" r="2.9"></circle>
            <path d="M8 1.6v1.5M8 12.9v1.5M1.6 8h1.5M12.9 8h1.5M3.5 3.5l1 1M11.5 11.5l1 1M3.5 12.5l1-1M11.5 4.5l1-1"></path>
          </>
        )}
        {o.value === 'dark' && <path d="M13.2 9.6A5.6 5.6 0 0 1 6.4 2.8a5.6 5.6 0 1 0 6.8 6.8Z"></path>}
        {o.value === 'system' && (
          <>
            <circle cx="8" cy="8" r="5.6"></circle>
            <path d="M8 2.4a5.6 5.6 0 0 1 0 11.2Z" fill="currentColor" stroke="none"></path>
          </>
        )}
      </svg>
    </button>
  ))}
</div>

<style>
  .theme {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
  }

  .theme[hidden] {
    display: none;
  }

  .theme__opt {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: var(--graphite);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .theme__opt:hover {
    color: var(--corona);
  }

  .theme__opt[aria-pressed='true'] {
    color: var(--corona);
    background: rgb(var(--corona-rgb) / 0.1);
  }

  .theme__opt svg {
    width: 15px;
    height: 15px;
  }
</style>
