---
/**
 * Sign-in, the signed-in card and the ring card's sharing, in one modal
 * dialog (see client/account.ts and client/card.ts). The buttons that open it
 * live in the HUD and the orbit menu (AccountButton), and on ring card pages.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const a = t.account;
const c = a.card;
---
<dialog class="account" id="account-dialog" aria-label={a.title} data-account-dialog data-label-in={a.label} data-label-out={a.title}>
  <button class="account__close" type="button" aria-label={a.close} data-account-close>
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"></path></svg>
  </button>

  <div class="account__view" data-account-view="out">
    <Logo class="account__mark" />
    <h2 class="account__title">{a.title}</h2>
    <p class="account__lede">{a.lede}</p>
    <p class="account__error" role="alert" data-account-error hidden>{a.failed}</p>
    <div class="account__providers">
      <button class="btn btn--primary account__provider" type="button" data-provider="github" data-busy={a.redirecting}><Icon name="github" /><span>{a.github}</span></button>
      <button class="btn btn--ghost account__provider" type="button" data-provider="google" data-busy={a.redirecting}><Icon name="google" /><span>{a.google}</span></button>
    </div>
    {a.note && <p class="account__note">{a.note}</p>}
    <p class="account__consent">{a.consent[0]}<a href={`${t.path}terms/`}>{a.consent[1]}</a>{a.consent[2]}<a href={`${t.path}privacy/`}>{a.consent[3]}</a>{a.consent[4]}</p>
  </div>

  <div class="account__view" data-account-view="in" hidden>
    <img class="account__avatar" alt="" width="55" height="55" data-account-avatar hidden />
    <p class="account__number mono"><span>SRN</span> <b data-account-number></b></p>
    <p class="account__name" data-account-name></p>
    <p class="account__error" role="alert" data-account-signout-error hidden>{a.signOutFailed}</p>
    <div class="account__stack">
      <button class="btn btn--primary" type="button" data-card-open>{c.open}</button>
      <button class="btn btn--ghost" type="button" data-account-signout>{a.signOut}</button>
    </div>
  </div>

  <div class="account__view account__view--card" data-account-view="card" data-card-path={`${t.path}ring/`} data-card-lang={t.lang} hidden>
    <button class="account__back" type="button" aria-label={c.back} data-card-back>
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 4.5L6.5 10l5.5 5.5"></path></svg>
    </button>
    <h2 class="account__title">{c.title}</h2>
    <div class="account__card" data-card-preview></div>
    <fieldset class="account__options">
      <legend class="sr-only">{c.show}</legend>
      <label class="account__option"><input type="checkbox" data-card-show="name" /><span>{c.showName}</span></label>
      <label class="account__option" data-card-image-option><input type="checkbox" data-card-show="image" /><span>{c.showImage}</span></label>
    </fieldset>
    <p class="account__status" role="status" data-card-status data-loading={c.loading} data-private={c.private} data-shared={c.shared} data-stopped={c.stopped}></p>
    <p class="account__error" role="alert" data-card-error hidden>{c.failed}</p>
    <div class="account__link" data-card-link hidden>
      <input class="account__url" type="text" readonly aria-label={c.link} data-card-url />
      <button class="btn btn--ghost" type="button" data-card-copy data-copied={c.copied}>{c.copy}</button>
    </div>
    <div class="account__actions">
      <button class="btn btn--primary" type="button" data-card-share>{c.share}</button>
      <button class="btn btn--primary" type="button" data-card-native hidden>{c.native}</button>
      <a class="btn btn--ghost" target="_blank" rel="noopener" data-card-post data-text={c.postText} hidden>{c.post}</a>
      <a class="btn btn--ghost" data-card-save>{c.save}</a>
    </div>
    <button class="account__stop" type="button" data-card-stop hidden>{c.stop}</button>
  </div>
</dialog>
