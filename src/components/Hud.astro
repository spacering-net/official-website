---
import Logo from './Logo.astro';
import AccountButton from './AccountButton.astro';
import { dicts, CHAPTER_IDS, type Dict } from '../i18n';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const other = dicts[t.lang === 'en' ? 'zh' : 'en'];
// Each link lights the rail while any chapter in its range is projected. Space,
// the assistant and Harness have links of their own; the ring covers the hero
// and the rest of its products; open source covers Codeg and the finale, and
// leads to the finale.
const own = (['space', 'assistant', 'harness'] as const).map((key) => ({ key, at: CHAPTER_IDS.indexOf(key) }));
const codeg = CHAPTER_IDS.indexOf('codeg');
const last = CHAPTER_IDS.length - 1;
const ring = [...Array(codeg).keys()].filter((i) => !own.some((p) => p.at === i)).join(',');
---
<header class="hud">
  <a class="brand" href={t.path} aria-label={t.nav.home} data-goto="0">
    <Logo class="brand__mark" />
    <span class="brand__word" aria-hidden="true">SpaceRing</span>
  </a>
  <div class="hud__right">
    <nav class="nav" aria-label={t.nav.label}>
      <a class="nav__link" href={`#${CHAPTER_IDS[0]}`} data-goto="0" data-range={ring} data-scramble>{t.nav.ring}</a>
      {own.map(({ key, at }) => (
        <a class="nav__link" href={`#${key}`} data-goto={at} data-range={`${at}`} data-scramble>{t.nav[key]}</a>
      ))}
      <a class="nav__link" href={`#${CHAPTER_IDS[last]}`} data-goto={last} data-range={`${codeg}-${last}`} data-scramble>{t.nav.openSource}</a>
      <svg class="nav__rail" aria-hidden="true"><path d=""></path></svg>
      <span class="nav__dot" aria-hidden="true"></span>
    </nav>
    <a class="lang-switch" href={other.path} hreflang={other.htmlLang} lang={other.htmlLang} aria-label={t.nav.langSwitchLabel} data-lang-switch={other.lang}>{t.nav.langSwitch}</a>
    <AccountButton t={t} />
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="orbit-menu" aria-label={t.nav.openMenu} data-menu-open>
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <g class="menu-btn__node">
          <ellipse class="menu-btn__orbit" cx="10" cy="10" rx="8.4" ry="7.27" transform="rotate(30 10 10)"></ellipse>
          <circle fill="var(--bead)" cx="6.37" cy="16.3" r="1.9"></circle>
        </g>
      </svg>
    </button>
  </div>
</header>
