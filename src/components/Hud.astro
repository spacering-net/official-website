---
import Logo from './Logo.astro';
import AccountButton from './AccountButton.astro';
import { CHAPTER_IDS, PAGES, type Dict } from '../i18n';

interface Props {
  t: Dict;
  /**
   * Any page but the homepage, and the page of PAGES this is or belongs to
   * (its link is marked as the current page). The ring's link then leads to
   * the homepage instead of scrolling to its top.
   */
  page?: { current?: keyof typeof PAGES };
}
const { t, page } = Astro.props;
// Space, the assistant, Harness and open source open their pages (PAGES); the
// ring opens the homepage, at its top. On the homepage each link also lights
// the rail while any chapter in its range is projected: Space, the assistant
// and Harness their own chapters; the ring the hero and the rest of its
// products; open source Codeg and the finale.
const own = (['space', 'assistant', 'harness'] as const).map((key) => ({ key, at: CHAPTER_IDS.indexOf(key) }));
const codeg = CHAPTER_IDS.indexOf('codeg');
const last = CHAPTER_IDS.length - 1;
const ring = [...Array(codeg).keys()].filter((i) => !own.some((p) => p.at === i)).join(',');
/** where a link goes: a page of its own, or the homepage's top (scrolled to, on the homepage) */
const link = (key: string, at: number) => {
  const own = PAGES[key as keyof typeof PAGES];
  if (own) return { href: `${t.path}${own}`, current: page?.current === key ? 'page' : undefined };
  if (page) return { href: at === 0 ? t.path : `${t.path}#${key}` };
  return { href: `#${key}`, goto: at };
};
const nav = [
  { label: t.nav.ring, range: ring, ...link(CHAPTER_IDS[0], 0) },
  ...own.map(({ key, at }) => ({ label: t.nav[key], range: `${at}`, ...link(key, at) })),
  { label: t.nav.openSource, range: `${codeg}-${last}`, ...link(CHAPTER_IDS[last], last) },
];
---
<header class:list={['hud', page && 'hud--page']}>
  <a class="brand" href={t.path} aria-label={t.nav.home} data-goto={page ? undefined : '0'}>
    <Logo class="brand__mark" />
    <span class="brand__word" aria-hidden="true">SpaceRing</span>
  </a>
  <div class="hud__right">
    <nav class="nav" aria-label={t.nav.label}>
      {nav.map((n) => (
        <a class="nav__link" href={n.href} data-goto={n.goto} data-range={n.range} aria-current={n.current} data-scramble>{n.label}</a>
      ))}
      <svg class="nav__rail" aria-hidden="true"><path d=""></path></svg>
      <span class="nav__dot" aria-hidden="true"></span>
    </nav>
    <AccountButton t={t} />
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="orbit-menu" aria-label={t.nav.openMenu} data-menu-open>
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <g class="menu-btn__node">
          <ellipse class="menu-btn__orbit" cx="10" cy="10" rx="8.4" ry="7.27" transform="rotate(30 10 10)"></ellipse>
          <circle fill="var(--bead)" cx="6.37" cy="16.3" r="1.9"></circle>
        </g>
      </svg>
    </button>
  </div>
</header>
