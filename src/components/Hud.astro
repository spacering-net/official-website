---
import Logo from './Logo.astro';
import HudAccount from './HudAccount.astro';
import { hudLinks } from './hud-links';
import type { Dict, PAGES } from '../i18n';
// before the first frame: the last signed-in user in the HUD's end
import hintRaw from '../client/account-hint.js?raw';
import hintUrl from '../client/account-hint.js?url&no-inline';

interface Props {
  t: Dict;
  /**
   * Any page but the homepage, and the page of PAGES this is or belongs to
   * (its link is marked as the current page). The ring's link then leads to
   * the homepage instead of scrolling to its top. At the page's top the HUD
   * is laid out as the homepage's; once the page scrolls, its ends gather
   * into the page's column (site.css, client/page.ts).
   */
  page?: { current?: keyof typeof PAGES };
}
const { t, page } = Astro.props;
const nav = hudLinks(t, page);
---
<header class:list={['hud', page && 'hud--page']}>
  <a class="brand" href={t.path} aria-label={t.nav.home} data-goto={page ? undefined : '0'}>
    <Logo class="brand__mark" />
    <span class="brand__word" aria-hidden="true">SpaceRing</span>
  </a>
  <div class="hud__right">
    <nav class="nav" aria-label={t.nav.label}>
      {nav.map((n) => (
        <a class="nav__link" href={n.href} data-goto={n.goto} aria-current={n.current} data-scramble>{n.label}</a>
      ))}
      <svg class="nav__rail" aria-hidden="true"><path d=""></path></svg>
      <span class="nav__dot" aria-hidden="true"></span>
    </nav>
    {/* where the links do not fit: they open in a menu of their own (NavSheet.astro) */}
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-sheet" data-nav-toggle data-open={t.nav.menu} data-close={t.nav.close}>{t.nav.menu}</button>
    <HudAccount t={t} />
  </div>
</header>
{/*
  Parsed before anything else is drawn: the head waits for #hud-end
  (rel=expect), which comes after this script. The homepage allows an
  inline script; the other pages allow only files from this site.
*/}
{page ? <script is:inline src={hintUrl}></script> : <script is:inline set:html={hintRaw}></script>}
<span id="hud-end" hidden></span>
