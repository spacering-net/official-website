---
/**
 * An item: what it is and who publishes it; beside it, its publisher, how to
 * install it, what it needs at a glance and its details, staying in view;
 * below, its description, what it needs (declared beside detected), what the
 * checks found, its files and versions, with a bar to move between them.
 * A prompt shows itself instead (with a button that copies it) and the
 * results made with it, and is used rather than installed. An assistant shows
 * its seal, its instructions, what to say to it and what it may use.
 */
import Copy from './Copy.astro';
import Avatar from './Avatar.astro';
import Shot from './Shot.astro';
import Seal from './Seal.astro';
import Access from './Access.astro';
import { harnessDicts, pick } from '../../i18n/harness';
import type { Lang } from '../../i18n';
import { modelName, withoutAgentWord, type ItemDetail, type VersionSummary } from '../../lib/harness';
import { compact } from '../../lib/github';

interface Props {
  lang: Lang;
  item: ItemDetail;
  /** the description, rendered and made safe when the version was made */
  readme: string | null;
  versions: VersionSummary[];
}
const { lang, item, readme, versions } = Astro.props;
const h = harnessDicts[lang];
const t = h.item;
const title = pick(item.title, lang) ?? item.name;
const summary = pick(item.summary, lang);
const install = item.install;
const perms = ['runsCode', 'installs', 'installScripts', 'network', 'secrets', 'paths', 'tools'] as const;
const declared = item.permissions.declared;
const detected = item.permissions.detected;
const size = (n: number) => (n < 1024 ? `${n} B` : n < 1024 * 1024 ? `${(n / 1024).toFixed(1)} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`);
const findingName = (f: ItemDetail['checks']['findings'][number]) => (f.check === 'rule' ? `${t.rule} · ${f.category ?? f.rule}` : (t.findings[f.check] ?? f.check));
const place = (f: { path?: string; line?: number }) => (f.path ? `${f.path}${f.line ? `:${f.line}` : ''}` : '');
// what deserves a warning first; low-severity marks (common commands, long lines) folded away
const order = { high: 0, medium: 1, low: 2 } as const;
const notable = item.checks.findings.filter((f) => f.severity !== 'low').sort((a, b) => order[a.severity] - order[b.severity]);
const minor = item.checks.findings.filter((f) => f.severity === 'low');
const sourceTree = install.source ? `https://github.com/${install.source.repository}/tree/${install.source.commit}/${install.source.path}` : null;
const launch = (install.packages ?? []).map((p) =>
  p.registryType === 'npm'
    ? `npx -y ${p.identifier}${p.version ? `@${p.version}` : ''}`
    : p.registryType === 'pypi'
      ? `uvx ${p.identifier}${p.version ? `==${p.version}` : ''}`
      : p.registryType === 'oci'
        ? `docker run -i --rm ${p.identifier}${p.version ? `:${p.version}` : ''}`
        : `${p.registryType}: ${p.identifier}${p.version ? ` ${p.version}` : ''}`,
);
const remotes = ((install.server?.remotes as { url?: string; type?: string }[] | undefined) ?? []).filter((r) => r.url);
const codeg = `codeg://harness/install?ref=${encodeURIComponent(item.ref)}`;
const publisherPage = `${h.base}${item.publisher.handle}`;

// a prompt: its text, the results made with it (the first is whoever shared it first), and its file to download
const prompt = item.kind === 'prompt' ? install.prompt : undefined;
const showcases = prompt?.showcases ?? [];
const SHOTS = 12;
const firstShared = showcases[0];
const promptBlob = prompt && install.archive ? install.files.find((f) => f.path === 'PROMPT.md') : undefined;
const model = modelName(prompt?.model);
const chars = prompt ? [...prompt.text].length : 0;

// an assistant: its definition (the one file), what to say to it, and its other settings
const assistant = item.kind === 'assistant' ? install.assistant : undefined;
const definition = assistant && install.archive ? install.files.find((f) => f.path === assistant.file) : undefined;
const assistantModel = assistant ? (assistant.model === 'inherit' ? h.assistant.inherit : modelName(assistant.model)) : null;
// what its examples' user turns say is shown with them, not again among the starters
const starters = assistant ? assistant.starters.filter((s) => !assistant.examples.some((e) => e.user === s)) : [];
const show = (v: unknown) => (typeof v === 'string' ? v : JSON.stringify(v)).slice(0, 160);
/** its other settings, and whether Codeg keeps each when it installs it */
const settings = assistant
  ? [
      ...(assistant.permissionMode ? [{ key: 'permissionMode', value: assistant.permissionMode, drops: !['default', 'manual', 'plan'].includes(assistant.permissionMode) }] : []),
      ...(assistant.hooks ? [{ key: 'hooks', value: '…', drops: true }] : []),
      ...assistant.mcpLaunches.map((n) => ({ key: `mcpServers.${n}`, value: 'command', drops: true })),
      ...Object.entries(assistant.settings).map(([key, value]) => ({ key, value: show(value), drops: false })),
    ]
  : [];
const needs = assistant ? [assistant.skills.length && h.assistant.skills(assistant.skills.length), assistant.mcpServers.length && h.assistant.mcp(assistant.mcpServers.length)].filter(Boolean) : [];
// what it may touch, in words for the glance: the kinds it may use, or all tools
const reach = assistant
  ? assistant.access.all
    ? h.assistant.access.all
    : (['read', 'edit', 'run', 'web'] as const)
        .filter((k) => assistant.access[k])
        .map((k) => h.assistant.access[k])
        .join(' · ')
  : '';

// files by folder, the top level first
const folders = new Map<string, typeof install.files>();
for (const f of install.files) {
  const dir = f.path.includes('/') ? f.path.slice(0, f.path.lastIndexOf('/')) : '';
  folders.set(dir, [...(folders.get(dir) ?? []), f]);
}
const dirs = [...folders.keys()].sort((a, b) => (a === '' ? -1 : b === '' ? 1 : a.localeCompare(b)));
const totalSize = install.files.reduce((s, f) => s + f.size, 0);
const fewFiles = install.files.length <= 24;

const sections = (
  assistant
    ? [
        { id: 'instructions', label: h.assistant.instructions, show: !!readme || !!install.source },
        { id: 'examples', label: h.assistant.examples, show: starters.length > 0 || assistant.examples.length > 0 },
        { id: 'capabilities', label: h.assistant.capabilities, show: true },
        { id: 'permissions', label: t.permissions, show: true },
        { id: 'checks', label: t.checks, show: true },
        { id: 'versions', label: t.versions, show: versions.length > 0 },
      ]
    : prompt
    ? [
        { id: 'prompt', label: h.prompt.text, show: true },
        { id: 'results', label: h.prompt.showcases, show: showcases.length > 0 },
        { id: 'checks', label: t.checks, show: true },
        { id: 'versions', label: t.versions, show: versions.length > 0 },
      ]
    : [
        { id: 'readme', label: t.description, show: !!readme || !!install.source },
        { id: 'server', label: t.server, show: !!install.server },
        { id: 'permissions', label: t.permissions, show: true },
        { id: 'checks', label: t.checks, show: true },
        { id: 'files', label: t.files, show: install.files.length > 0 },
        { id: 'versions', label: t.versions, show: versions.length > 0 },
      ]
).filter((s) => s.show);
// a description that opens with the item's own title says it once, in the page's heading
// (an assistant's title may be its heading without "Agent")
const opening = readme ? /^\s*<h1[^>]*>(.*?)<\/h1>\s*/s.exec(readme) : null;
const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').trim().toLowerCase();
const said = opening ? [plain(opening[1]), withoutAgentWord(plain(opening[1]))] : [];
const body = readme && opening && [title, item.name].some((x) => said.includes(x.toLowerCase())) ? readme.slice(opening[0].length) : readme;
const usage = {
  runs: detected.runsCode,
  hosts: detected.network.length,
  secrets: detected.secrets.length,
};
---
<div class="wrap item">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={h.base}>Harness</a>
    <span aria-hidden="true">/</span>
    <a href={publisherPage}>{item.publisher.handle}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{item.name}</span>
  </nav>
  <div class="layout">
    <div class="top">
      <header class="head">
        <p class="head__badges">
          <span class="badge badge--kind">{h.kind[item.kind]}</span>
          <span class={`badge badge--risk-${item.risk}`}><span class={`risk-dot risk-dot--${item.risk}`}></span>{t.risk[item.risk]}</span>
          {item.status === 'listed' && <span class="badge badge--listed">{t.listed}</span>}
          {item.publisher.unclaimed && <span class="badge">{h.card.unclaimed}</span>}
        </p>
        {assistant ? (
          <div class="head__title">
            <Seal seed={item.ref} title={title} color={assistant.color} size={72} />
            <h1>{title}</h1>
          </div>
        ) : (
          <h1>{title}</h1>
        )}
        {assistant?.vibe && <p class="head__vibe">{assistant.vibe}</p>}
        {summary && (
          <div class="head__summary" data-clamp>
            <p>{summary}</p>
            <button class="head__more" type="button" data-clamp-toggle data-less={t.collapse} hidden>{t.expand}</button>
          </div>
        )}
        <p class="head__by">
          <a class="head__pub" href={publisherPage}>
            <Avatar handle={item.publisher.handle} avatar={item.publisher.avatar} size={24} />
            <span>{item.publisher.name}</span>
          </a>
          {firstShared?.by && (
            <span class="head__credit">
              {h.prompt.sharedBy}
              {firstShared.link ? (
                <a href={firstShared.link} rel="nofollow ugc noopener" target="_blank">@{firstShared.by.name} ↗</a>
              ) : (
                <span>@{firstShared.by.name}</span>
              )}
            </span>
          )}
          <span class="head__ref">
            <code>{item.ref}</code>
            <Copy lang={lang} text={item.ref} />
          </span>
          {item.repoStars !== null && item.repoStars > 0 && <span class="head__meta" title={t.stars}>★ {compact(item.repoStars)}</span>}
          {assistant?.plugin && <span class="head__meta">{h.assistant.plugin} · {assistant.plugin}</span>}
          <span class="head__meta">{t.updated} {h.date(item.latest.publishedAt)}</span>
        </p>
      </header>

      {item.status === 'listed' && (
        <p class="notice">
          {t.listedNote} {item.listedReasons.map((r) => t.reasons[r] ?? r).join(lang === 'zh' ? '；' : '; ')}
        </p>
      )}
    </div>

    <div class="main">
      {sections.length > 1 && (
        <nav class="toc" aria-label={t.toc} data-toc>
          {sections.map((s) => (
            <a href={`#${s.id}`}>{s.label}</a>
          ))}
        </nav>
      )}

      {prompt && (
        <section class="section" id="prompt" data-section>
          <h2 class="eyebrow section__title">
            {h.prompt.text}
            <span class="section__aside">{h.prompt.chars(chars)}</span>
          </h2>
          {prompt.partial && item.status !== 'listed' && <p class="notice">{h.prompt.partialNote}</p>}
          <div class="prompt" data-prompt>
            <pre class="prompt__text" id="prompt-text">{prompt.text}</pre>
            <Copy lang={lang} from="prompt-text" label={h.prompt.copy} class="prompt__copy" />
            <button class="prompt__more" type="button" data-prompt-toggle data-less={t.collapse} hidden>{t.expand}</button>
          </div>
          {prompt.rights === 'creators' && (
            <p class="small muted credit">
              {h.prompt.credit} <a href="mailto:privacy@spacering.net">privacy@spacering.net</a>
            </p>
          )}
        </section>
      )}

      {showcases.length > 0 && (
        <section class="section" id="results" data-section>
          <h2 class="eyebrow section__title">
            {h.prompt.showcases}
            <span class="section__aside">{h.prompt.results(showcases.length)}</span>
          </h2>
          <ul class:list={['shots', showcases.length === 1 && 'shots--one']}>
            {showcases.slice(0, SHOTS).map((s) => <Shot lang={lang} shot={s} />)}
          </ul>
          {showcases.length > SHOTS && (
            <details class="shots__more">
              <summary>{h.prompt.showAll(showcases.length)}</summary>
              <ul class="shots">
                {showcases.slice(SHOTS).map((s) => <Shot lang={lang} shot={s} />)}
              </ul>
            </details>
          )}
        </section>
      )}

      {sections.some((s) => s.id === 'instructions') && (
        <section class="section" id="instructions" data-section>
          <h2 class="eyebrow section__title">{h.assistant.instructions}</h2>
          {readme ? (
            <div class="setting" data-fold>
              <div class="readme setting__text" data-fold-text set:html={body} />
              <button class="setting__more" type="button" data-fold-toggle data-less={t.collapse} hidden>{t.expand}</button>
            </div>
          ) : (
            <p class="elsewhere">
              {t.readmeElsewhere}
              {sourceTree && <a href={sourceTree} rel="nofollow ugc noopener" target="_blank">{item.install.source?.repository} ↗</a>}
            </p>
          )}
        </section>
      )}

      {assistant && sections.some((s) => s.id === 'examples') && (
        <section class="section" id="examples" data-section>
          <h2 class="eyebrow section__title">{h.assistant.examples}</h2>
          {starters.length > 0 && (
            <>
              <h3 class="sub">{h.assistant.starters}</h3>
              <ul class="starters">
                {starters.map((s) => (
                  <li class="starter">
                    <span class="starter__text">{s}</span>
                    <Copy lang={lang} text={s} />
                  </li>
                ))}
              </ul>
            </>
          )}
          {assistant.examples.length > 0 && (
            <>
              <h3 class="sub">{h.assistant.dialogues}</h3>
              <ol class="dialogues">
                {assistant.examples.map((e) => (
                  <li class="dialogue">
                    {e.context && <p class="dialogue__context">{e.context}</p>}
                    <p class="bubble bubble--user">
                      <span class="bubble__who">{h.assistant.user}</span>
                      {e.user}
                    </p>
                    {e.assistant && (
                      <p class="bubble bubble--main">
                        <span class="bubble__who">{h.assistant.reply}</span>
                        {e.assistant}
                      </p>
                    )}
                    {e.commentary && (
                      <details class="dialogue__why">
                        <summary>{h.assistant.why}</summary>
                        <p>{e.commentary}</p>
                      </details>
                    )}
                  </li>
                ))}
              </ol>
            </>
          )}
        </section>
      )}

      {assistant && (
        <section class="section" id="capabilities" data-section>
          <h2 class="eyebrow section__title">{h.assistant.capabilities}</h2>
          <dl class="caps">
            <div>
              <dt>{h.assistant.tools}</dt>
              <dd>
                <Access access={assistant.access} lang={lang} />
                {assistant.tools ? (
                  <p class="caps__codes">{assistant.tools.map((x) => <code>{x}</code>)}</p>
                ) : (
                  <p class="caps__note">{h.assistant.allToolsNote}</p>
                )}
                {assistant.disallowedTools.length > 0 && (
                  <p class="caps__codes">
                    <span class="caps__label">{h.assistant.denied}</span>
                    {assistant.disallowedTools.map((x) => <code>{x}</code>)}
                  </p>
                )}
              </dd>
            </div>
            <div>
              <dt>{h.assistant.model}</dt>
              <dd>{assistantModel ?? <span class="muted">{h.assistant.modelUnset}</span>}</dd>
            </div>
            <div>
              <dt>{h.assistant.skillsLabel}</dt>
              <dd>
                {assistant.skills.length ? (
                  <ul class="caps__list">
                    {assistant.skills.map((sk) => (
                      <li>
                        {sk.ref ? <a href={`${h.base}${sk.ref}`}>{sk.name}</a> : <code>{sk.name}</code>}
                        {!sk.ref && <span class="muted"> · {h.assistant.notInHarness}</span>}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <span class="muted">{t.nothing}</span>
                )}
              </dd>
            </div>
            <div>
              <dt>{h.assistant.mcpLabel}</dt>
              <dd>{assistant.mcpServers.length ? <p class="caps__codes">{assistant.mcpServers.map((x) => <code>{x}</code>)}</p> : <span class="muted">{t.nothing}</span>}</dd>
            </div>
            {settings.length > 0 && (
              <div>
                <dt>{h.assistant.settings}</dt>
                <dd>
                  <ul class="caps__list">
                    {settings.map((x) => (
                      <li>
                        <code>{x.key}: {x.value}</code>
                        <span class:list={['caps__keep', x.drops && 'caps__keep--drops']}> · {x.drops ? h.assistant.drops : h.assistant.keeps}</span>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        </section>
      )}

      {sections.some((s) => s.id === 'readme') && (
        <section class="section" id="readme" data-section>
          <h2 class="eyebrow section__title">{t.description}</h2>
          {readme ? (
            <div class="readme" set:html={body} />
          ) : (
            <p class="elsewhere">
              {t.readmeElsewhere}
              {sourceTree && <a href={sourceTree} rel="nofollow ugc noopener" target="_blank">{item.install.source?.repository} ↗</a>}
            </p>
          )}
        </section>
      )}

      {install.server && (
        <section class="section" id="server" data-section>
          <h2 class="eyebrow section__title">{t.server}</h2>
          <div class="json">
            <Copy lang={lang} text={JSON.stringify(install.server, null, 2)} />
            <pre><code>{JSON.stringify(install.server, null, 2)}</code></pre>
          </div>
        </section>
      )}

      {!prompt && (
      <section class="section" id="permissions" data-section>
        <h2 class="eyebrow section__title">{t.permissions}</h2>
        <div class="perms" role="table" aria-label={t.permissions}>
          <div class="perms__row perms__row--head" role="row">
            <span role="columnheader"></span>
            <span role="columnheader">{t.declared}</span>
            <span role="columnheader">{t.detected}</span>
          </div>
          {perms.map((k) => {
            const d = declared[k];
            const found = detected[k];
            const extra = d ? found.filter((x) => !d.includes(x)) : [];
            return (
              <div class:list={['perms__row', found.length > 0 && 'perms__row--some']} role="row">
                <span class="perms__name" role="rowheader">{t.perms[k]}</span>
                <span class="perms__values" role="cell">
                  {d === undefined ? <span class="muted">—</span> : d.length ? d.map((x) => <code>{x}</code>) : <span class="muted">{t.nothing}</span>}
                </span>
                <span class="perms__values" role="cell">
                  {found.length ? found.map((x) => <code class:list={[extra.includes(x) && 'differs']}>{x === '*' ? h.assistant.access.all : x}</code>) : <span class="muted">{t.nothing}</span>}
                </span>
              </div>
            );
          })}
        </div>
      </section>
      )}

      <section class="section" id="checks" data-section>
        <h2 class="eyebrow section__title">{t.checks}</h2>
        <div class={`verdict verdict--${item.risk}`}>
          <span class={`risk-dot risk-dot--${item.risk}`}></span>
          <div>
            <p class="verdict__title">{t.risk[item.risk]} · {t.riskNote[item.risk]}</p>
            <p class="verdict__note">{item.reviewed ? t.reviewed : t.notReviewed} · {t.modelOff}</p>
          </div>
        </div>
        {notable.length > 0 && (
          <ul class="findings">
            {notable.map((f) => (
              <li>
                <span class={`badge badge--risk-${f.severity}`}>{t.risk[f.severity]}</span>
                <span>{findingName(f)}</span>
                <code>{place(f)}</code>
              </li>
            ))}
          </ul>
        )}
        {minor.length > 0 && (
          <details class="minor">
            <summary>{t.minorFindings(minor.length)}</summary>
            <ul class="findings findings--minor">
              {minor.map((f) => (
                <li>
                  <span>{findingName(f)}</span>
                  <code>{place(f)}</code>
                </li>
              ))}
            </ul>
          </details>
        )}
        {item.checks.secrets > 0 && <p class="small muted">{t.secretsFound(item.checks.secrets)}</p>}
        {item.checks.dropped.length > 0 && (
          <p class="small muted">
            {t.dropped}: <code>{item.checks.dropped.map((d) => d.path).join(', ')}</code>
          </p>
        )}
      </section>

      {!prompt && !assistant && install.files.length > 0 && (
        <section class="section" id="files" data-section>
          <h2 class="eyebrow section__title">
            {t.files}
            <span class="section__aside">{t.filesTotal(install.files.length, size(totalSize))}</span>
          </h2>
          <div class="tree">
            {dirs.map((dir) =>
              dir === '' ? (
                <ul class="tree__files">
                  {folders.get('')!.map((f) => (
                    <li>
                      <span class="tree__name">{f.path}{f.executable && <span class="tree__x" title="executable">x</span>}</span>
                      <span class="tree__size">{size(f.size)}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <details class="tree__dir" open={fewFiles}>
                  <summary>
                    <span class="tree__name">{dir}/</span>
                    <span class="tree__size">{folders.get(dir)!.length}</span>
                  </summary>
                  <ul class="tree__files">
                    {folders.get(dir)!.map((f) => (
                      <li>
                        <span class="tree__name">{f.path.slice(dir.length + 1)}{f.executable && <span class="tree__x" title="executable">x</span>}</span>
                        <span class="tree__size">{size(f.size)}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              ),
            )}
          </div>
          {install.files.length > 0 && !install.archive && install.source && <p class="small muted">{t.notHosted}</p>}
        </section>
      )}

      {versions.length > 0 && (
        <section class="section" id="versions" data-section>
          <h2 class="eyebrow section__title">{t.versions}</h2>
          <ol class="versions">
            {versions.slice(0, 20).map((v) => (
              <li class:list={[v.revision === item.latest.revision && 'is-latest']}>
                <span class="versions__rev">#{v.revision}</span>
                <span class="versions__v">{v.version ?? '—'}</span>
                {v.revision === item.latest.revision && <span class="badge badge--kind">{t.current}</span>}
                <span class="versions__date">{h.date(v.publishedAt)}</span>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>

    <aside class="side">
      <div class="side__inner">
        <section class="panel publisher" aria-labelledby="publisher-title">
          <h2 class="eyebrow" id="publisher-title">{h.publisher.label}</h2>
          <a class="publisher__link" href={publisherPage}>
            <Avatar handle={item.publisher.handle} avatar={item.publisher.avatar} size={40} />
            <span class="publisher__text">
              <span class="publisher__name">{item.publisher.name}</span>
              <span class="publisher__all">{t.publisherAll}</span>
            </span>
            <svg class="publisher__go" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </a>
        </section>

        {prompt ? (
          <section class="panel install" data-install aria-labelledby="install-title">
            <h2 class="eyebrow" id="install-title">{h.prompt.use}</h2>
            <div class="install__actions">
              <button class="btn btn--primary use__copy" type="button" data-copy="" data-copy-from="prompt-text" data-done={h.copy.done} hidden>
                <span class="use__idle">{h.prompt.copy}</span>
                <span class="use__done">{h.copy.done}</span>
              </button>
              <a class="btn btn--ghost" href={codeg}>{t.openInCodeg}</a>
              {promptBlob && (
                <a class="btn btn--ghost" href={`/api/harness/v1/blobs/${promptBlob.sha256}`} download="PROMPT.md">{h.prompt.download}</a>
              )}
            </div>
            <p class="install__note">{h.prompt.useNote}</p>
          </section>
        ) : assistant ? (
          <section class="panel install" data-install aria-labelledby="install-title">
            <h2 class="eyebrow" id="install-title">{t.install}</h2>
            <div class="install__actions">
              <a class="btn btn--primary" href={codeg}>
                {t.openInCodeg}
                <svg class="btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
              </a>
              {definition && (
                <a class="btn btn--ghost" href={`/api/harness/v1/blobs/${definition.sha256}`} download={assistant.file} title={assistant.file}>
                  {h.assistant.download}
                  <span class="install__size">{size(definition.size)}</span>
                </a>
              )}
              {definition && (
                <button class="btn btn--ghost use__copy" type="button" data-copy="" data-copy-src={`/api/harness/v1/blobs/${definition.sha256}`} data-done={h.copy.done} hidden>
                  <span class="use__idle">{h.assistant.copy}</span>
                  <span class="use__done">{h.copy.done}</span>
                </button>
              )}
            </div>
            <p class="install__note">
              {install.source ? (
                <>
                  {t.notHosted}{' '}
                  <a href={sourceTree} rel="nofollow ugc noopener" target="_blank">{t.commit} {install.source.commit.slice(0, 7)} ↗</a>
                </>
              ) : (
                h.assistant.note
              )}
            </p>
          </section>
        ) : (
        <section class="panel install" data-install aria-labelledby="install-title">
          <h2 class="eyebrow" id="install-title">{t.install}</h2>
          <div class="install__actions">
            <a class="btn btn--primary" href={codeg}>
              {t.openInCodeg}
              <svg class="btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
            </a>
            {install.archive && (
              <a class="btn btn--ghost" href={install.archive.url} download>
                {t.download}
                <span class="install__size">{size(install.archive.size)}</span>
              </a>
            )}
          </div>
          {launch.map((cmd) => (
            <div class="cmd">
              <code>{cmd}</code>
              <Copy lang={lang} text={cmd} />
            </div>
          ))}
          {remotes.map((r) => (
            <div class="cmd">
              <code>{r.url}</code>
              <Copy lang={lang} text={r.url!} />
            </div>
          ))}
          <p class="install__note">
            {install.source ? (
              <>
                {t.notHosted}{' '}
                <a href={sourceTree} rel="nofollow ugc noopener" target="_blank">{t.commit} {install.source.commit.slice(0, 7)} ↗</a>
              </>
            ) : install.files.length > 0 ? (
              t.codegNote
            ) : null}
          </p>
        </section>
        )}

        {prompt ? (
          <section class="panel glance" aria-labelledby="glance-title">
            <h2 class="eyebrow" id="glance-title">{h.prompt.glance}</h2>
            <dl class="facts-list">
              <div>
                <dt>{t.checks}</dt>
                <dd><span class={`badge badge--risk-${item.risk}`}><span class={`risk-dot risk-dot--${item.risk}`}></span>{t.risk[item.risk]}</span></dd>
              </div>
              {model && (
                <div>
                  <dt>{h.prompt.model}</dt>
                  <dd>{model}</dd>
                </div>
              )}
              {prompt.lang && (
                <div>
                  <dt>{h.prompt.lang}</dt>
                  <dd>{h.prompt.langs[prompt.lang] ?? prompt.lang}</dd>
                </div>
              )}
              <div>
                <dt>{h.prompt.length}</dt>
                <dd>{h.prompt.chars(chars)}</dd>
              </div>
              {showcases.length > 0 && (
                <div>
                  <dt>{h.prompt.count}</dt>
                  <dd><a href="#results">{h.prompt.results(showcases.length)}</a></dd>
                </div>
              )}
            </dl>
          </section>
        ) : assistant ? (
          <section class="panel glance" aria-labelledby="glance-title">
            <h2 class="eyebrow" id="glance-title">{h.assistant.glance}</h2>
            <dl class="facts-list">
              <div>
                <dt>{t.checks}</dt>
                <dd><span class={`badge badge--risk-${item.risk}`}><span class={`risk-dot risk-dot--${item.risk}`}></span>{t.risk[item.risk]}</span></dd>
              </div>
              <div>
                <dt>{h.assistant.model}</dt>
                <dd>{assistantModel ?? <span class="muted">{h.assistant.modelUnset}</span>}</dd>
              </div>
              <div>
                <dt>{h.assistant.access.label}</dt>
                <dd>{reach || <span class="muted">{t.nothing}</span>}</dd>
              </div>
              <div>
                <dt>{h.assistant.needs}</dt>
                <dd>{needs.length ? needs.join(' · ') : <span class="muted">{t.nothing}</span>}</dd>
              </div>
            </dl>
            <a class="panel__more" href="#capabilities">{h.assistant.capabilities} <span aria-hidden="true">→</span></a>
          </section>
        ) : (
        <section class="panel glance" aria-labelledby="glance-title">
          <h2 class="eyebrow" id="glance-title">{t.safety}</h2>
          <dl class="facts-list">
            <div>
              <dt>{t.checks}</dt>
              <dd><span class={`badge badge--risk-${item.risk}`}><span class={`risk-dot risk-dot--${item.risk}`}></span>{t.risk[item.risk]}</span></dd>
            </div>
            <div>
              <dt>{t.perms.runsCode}</dt>
              <dd>{usage.runs.length ? <code>{usage.runs.join(', ')}</code> : <span class="muted">{t.nothing}</span>}</dd>
            </div>
            <div>
              <dt>{t.perms.network}</dt>
              <dd>{usage.hosts ? t.hosts(usage.hosts) : <span class="muted">{t.nothing}</span>}</dd>
            </div>
            <div>
              <dt>{t.perms.secrets}</dt>
              <dd>{usage.secrets ? t.credentials(usage.secrets) : <span class="muted">{t.nothing}</span>}</dd>
            </div>
          </dl>
          <a class="panel__more" href="#permissions">{t.permissions} <span aria-hidden="true">→</span></a>
        </section>
        )}

        <section class="panel facts" aria-labelledby="facts-title">
          <h2 class="eyebrow" id="facts-title">{t.facts}</h2>
          <dl class="facts-list">
            {item.latest.version && (
              <div>
                <dt>{t.version}</dt>
                <dd><code>{item.latest.version}</code></dd>
              </div>
            )}
            <div>
              <dt>{t.revision}</dt>
              <dd><code>#{item.latest.revision}</code></dd>
            </div>
            {prompt?.rights === 'creators' ? (
              <div>
                <dt>{h.prompt.rights}</dt>
                <dd>{firstShared?.link ? <a href={firstShared.link} rel="nofollow ugc noopener" target="_blank">{h.prompt.creators} ↗</a> : h.prompt.creators}</dd>
              </div>
            ) : (
              <div>
                <dt>{t.license}</dt>
                <dd>{item.license ? <code>{item.license}</code> : <span class="muted">{t.noLicense}</span>}</dd>
              </div>
            )}
            {firstShared?.by && (
              <div>
                <dt>{h.prompt.sharedBy}</dt>
                <dd>{firstShared.by.url ? <a href={firstShared.by.url} rel="nofollow ugc noopener" target="_blank">@{firstShared.by.name} ↗</a> : `@${firstShared.by.name}`}</dd>
              </div>
            )}
            {assistant?.plugin && (
              <div>
                <dt>{h.assistant.plugin}</dt>
                <dd>
                  <code>{assistant.plugin}</code>
                  {assistant.alsoIn.length > 0 && <span class="facts__more">{h.assistant.alsoIn(assistant.alsoIn.length)}</span>}
                </dd>
              </div>
            )}
            {!prompt && !assistant && (
              <div>
                <dt>{t.runtime}</dt>
                <dd>{h.runtime.names[item.runtime] ?? item.runtime}</dd>
              </div>
            )}
            <div>
              <dt>{t.source}</dt>
              <dd>{item.sourceUrl ? <a href={item.sourceUrl} rel="nofollow ugc noopener" target="_blank">{t.sources[item.source]} ↗</a> : t.sources[item.source]}</dd>
            </div>
            {item.repositoryUrl && (
              <div>
                <dt>{prompt ? h.prompt.collected : t.repository}</dt>
                <dd><a href={item.repositoryUrl} rel="nofollow ugc noopener" target="_blank">{item.repositoryUrl.replace(/^https:\/\/(www\.)?(github\.com\/)?/, '')} ↗</a></dd>
              </div>
            )}
            {item.websiteUrl && (
              <div>
                <dt>{t.website}</dt>
                <dd><a href={item.websiteUrl} rel="nofollow ugc noopener" target="_blank">{item.websiteUrl.replace(/^https:\/\/(www\.)?/, '')} ↗</a></dd>
              </div>
            )}
          </dl>
        </section>

      </div>
    </aside>
  </div>

  <div class="dock" data-dock hidden>
    <span class="dock__title">{title}</span>
    {prompt ? (
      <button class="btn btn--primary use__copy" type="button" data-copy="" data-copy-from="prompt-text" data-done={h.copy.done} hidden>
        <span class="use__idle">{h.prompt.copy}</span>
        <span class="use__done">{h.copy.done}</span>
      </button>
    ) : (
      <a class="btn btn--primary" href={codeg}>{t.openInCodeg}</a>
    )}
  </div>
</div>

<style>
  .item {
    --toc-h: 52px;
    padding-top: var(--s-5);
  }

  /* ---------------------------------------------------------------- layout */

  /* the head and the content, and beside both, from the top, the side */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    grid-template-rows: auto 1fr;
    column-gap: var(--s-7);
    margin-top: var(--s-5);
  }

  .top {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .main {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
    margin-top: var(--s-6);
  }

  .side {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-width: 0;
  }

  .side__inner > * {
    min-width: 0;
  }

  .side__inner {
    position: sticky;
    top: calc(var(--hud-h) + var(--s-5));
    display: grid;
    gap: var(--s-4);
    max-height: calc(100dvh - var(--hud-h) - var(--s-6));
    /* room for the focus ring of what sits on the panels' edges */
    margin: -4px;
    padding: 4px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  /* ------------------------------------------------------------------ head */

  .head__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  h1 {
    margin-top: var(--s-4);
    font-size: clamp(32px, 4.4vw, 54px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .head__summary {
    margin-top: var(--s-4);
  }

  .head__summary p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--corona-64);
  }

  .head__summary.is-clamped p {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .head__more {
    margin-top: var(--s-2);
    font-size: 13.5px;
    color: var(--bead);
  }

  .head__more:hover {
    color: var(--bead-hot);
  }

  .head__by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-5);
    font-size: 14px;
    color: var(--graphite);
  }

  .head__pub {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--corona);
    transition: color 0.2s;
  }

  .head__pub:hover {
    color: var(--bead-hot);
  }

  .head__ref {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .head__ref code,
  .head__meta {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .head__credit {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .head__credit a,
  .head__credit span {
    font-family: var(--f-mono);
    font-size: 12.5px;
    color: var(--corona-80);
  }

  .head__credit a:hover {
    color: var(--bead-hot);
  }

  .notice {
    margin-top: var(--s-5);
    padding: var(--s-4) var(--s-5);
    border: 1px solid rgb(var(--ion-rgb) / 0.3);
    border-radius: 13px;
    background: rgb(var(--ion-rgb) / 0.05);
    font-size: 14px;
    color: var(--corona-64);
  }

  /* the bar of sections, under the HUD */
  .toc {
    position: sticky;
    top: var(--hud-h);
    z-index: 10;
    display: flex;
    gap: var(--s-5);
    height: var(--toc-h);
    align-items: stretch;
    overflow-x: auto;
    background: rgb(var(--void-rgb) / 0.86);
    border-bottom: 1px solid var(--hairline);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    scrollbar-width: none;
  }

  .toc::-webkit-scrollbar {
    display: none;
  }

  .toc a {
    position: relative;
    display: flex;
    align-items: center;
    flex: none;
    font-size: 14.5px;
    color: var(--corona-64);
    transition: color 0.2s;
  }

  .toc a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--bead);
    box-shadow: 0 0 8px var(--bead-glow);
    scale: 0 1;
    transition: scale 0.35s var(--ease-out);
  }

  .toc a:hover {
    color: var(--corona);
  }

  .toc a[aria-current] {
    color: var(--bead);
  }

  .toc a[aria-current]::after {
    scale: 1 1;
  }

  /* -------------------------------------------------------------- sections */

  .section {
    padding: var(--s-6) 0;
    scroll-margin-top: calc(var(--hud-h) + var(--toc-h));
  }

  .section + .section {
    border-top: 1px solid var(--hairline);
  }

  .section__title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }

  .section__aside {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: none;
  }

  .small {
    margin-top: var(--s-4);
    font-size: 13.5px;
  }

  code {
    font-family: var(--f-mono);
    font-size: 0.86em;
  }

  .elsewhere {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    color: var(--corona-64);
  }

  .elsewhere a {
    color: var(--bead);
  }

  /* ------------------------------------------------------------ an assistant */

  /* its seal beside its title */
  .head__title {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-4);
  }

  .head__title h1 {
    margin-top: 0;
  }

  /* a line about itself, before what it does */
  .head__vibe {
    margin-top: var(--s-4);
    font-family: var(--f-display);
    font-size: 19px;
    font-weight: 300;
    font-style: italic;
    color: var(--corona-80);
  }

  /* its instructions fold to their first screens (client/harness.ts) */
  .setting.is-folded .setting__text {
    max-height: calc(26 * 1.75em);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 calc(100% - 5em), transparent);
    mask-image: linear-gradient(#000 calc(100% - 5em), transparent);
  }

  .setting__more {
    margin-top: var(--s-3);
    font-size: 13.5px;
    color: var(--bead);
  }

  .setting__more:hover {
    color: var(--bead-hot);
  }

  .sub {
    margin: var(--s-5) 0 var(--s-3);
    font-size: 13px;
    font-weight: 400;
    color: var(--corona-64);
  }

  .sub:first-of-type {
    margin-top: 0;
  }

  /* things to say to it, each to copy */
  .starters {
    display: grid;
    gap: var(--s-2);
  }

  .starter {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-4);
    border: 1px solid var(--hairline);
    border-left: 2px solid rgb(var(--bead-rgb) / 0.5);
    border-radius: 10px;
    background: var(--well);
  }

  .starter__text {
    flex: 1;
    min-width: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--corona);
    overflow-wrap: anywhere;
  }

  /* when it is called: the user, then the main session handing the work over */
  .dialogues {
    display: grid;
    gap: var(--s-5);
  }

  .dialogue {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  .dialogue__context {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--graphite);
  }

  .bubble {
    max-width: min(100%, 38rem);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--hairline);
    border-radius: 13px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--corona-80);
    overflow-wrap: anywhere;
  }

  .bubble--user {
    border-bottom-left-radius: 4px;
    background: var(--well);
    color: var(--corona);
  }

  .bubble--main {
    margin-left: var(--s-6);
    border-bottom-right-radius: 4px;
    background: rgb(var(--bead-rgb) / 0.05);
    border-color: rgb(var(--bead-rgb) / 0.22);
  }

  .bubble__who {
    display: block;
    margin-bottom: 2px;
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--graphite);
  }

  .dialogue__why summary {
    font-size: 13px;
    color: var(--corona-64);
    cursor: pointer;
  }

  .dialogue__why p {
    margin-top: var(--s-2);
    font-size: 14px;
    color: var(--corona-64);
  }

  /* what it may use: label beside value, as the side's panels */
  .caps {
    display: grid;
  }

  .caps > div {
    display: grid;
    grid-template-columns: var(--label-w) minmax(0, 1fr);
    gap: var(--s-4);
    padding: var(--s-4) 0;
    border-top: 1px solid var(--hairline);
  }

  .caps > div:first-child {
    border-top: none;
    padding-top: 0;
  }

  .caps dt {
    font-size: 13.5px;
    color: var(--graphite);
  }

  .caps dd {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    min-width: 0;
    font-size: 14.5px;
    color: var(--corona-80);
  }

  .caps__codes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .caps__codes code,
  .caps__list code {
    padding: 2px 7px;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--well);
    font-size: 12px;
    color: var(--corona-80);
    overflow-wrap: anywhere;
  }

  .caps__label {
    margin-right: var(--s-2);
    font-size: 13px;
    color: var(--graphite);
  }

  .caps__note {
    font-size: 13.5px;
    color: var(--corona-64);
  }

  .caps__list {
    display: grid;
    gap: var(--s-2);
  }

  .caps__list a {
    color: var(--bead);
  }

  .caps__list a:hover {
    color: var(--bead-hot);
  }

  .caps__keep {
    font-size: 12.5px;
    color: var(--graphite);
  }

  .caps__keep--drops {
    color: var(--bead);
  }

  .facts__more {
    display: block;
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--graphite);
  }

  /* the marks of what it may touch wrap here, where a card would cut them */
  .caps :global(.access) {
    flex-wrap: wrap;
    row-gap: var(--s-2);
  }

  @media (max-width: 760px) {
    .caps > div {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }

    .head__title {
      gap: var(--s-4);
    }
  }

  /* A prompt, as written: its own line breaks, the column's width, the
     copy button in its corner; a long one folds (client/harness.ts). */
  .prompt {
    position: relative;
    padding: var(--s-5) calc(var(--s-5) + 30px) var(--s-5) var(--s-5);
    border: 1px solid var(--hairline);
    border-left: 2px solid rgb(var(--bead-rgb) / 0.55);
    border-radius: 13px;
    background: var(--well);
  }

  .prompt__text {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: inherit;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--corona);
  }

  .prompt.is-folded .prompt__text {
    max-height: calc(16 * 1.75em);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 calc(100% - 4.5em), transparent);
