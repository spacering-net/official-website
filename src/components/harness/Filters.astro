---
/**
 * The catalog's filters: where items run, chosen from a list, and what they
 * are about, as tags; each with how many are on the shelves. The same in the
 * sidebar and, on small screens, in the filter sheet. A runtime chosen applies
 * at once (client/harness.ts); without scripts the list is a form, and the
 * tags are plain links.
 */
import { harnessDicts } from '../../i18n/harness';
import type { Lang } from '../../i18n';
import { withQuery, type BrowseState, type TagInfo } from '../../lib/harness';

interface Props {
  lang: Lang;
  path: string;
  state: BrowseState;
  tags: TagInfo[];
  counts: Record<string, number>;
}
const { lang, path, state, tags, counts } = Astro.props;
const h = harnessDicts[lang];
const n = (v: number) => v.toLocaleString(lang === 'zh' ? 'zh-CN' : 'en');
// with a kind chosen, its own runtimes and counts ('runtime:node@skill'); otherwise the catalog's ('runtime:node')
const within = state.kind ? `@${state.kind}` : '';
const runtimes = Object.entries(counts)
  .filter(([k, v]) => k.startsWith('runtime:') && (within ? k.endsWith(within) : !k.includes('@')) && v > 0)
  .map(([k, v]) => ({ id: k.slice('runtime:'.length, k.length - within.length), n: v }))
  .sort((a, b) => b.n - a.n);
// a runtime asked for that has nothing on the shelves is still the one shown as chosen
if (state.runtime && !runtimes.some((r) => r.id === state.runtime)) runtimes.push({ id: state.runtime, n: 0 });
const runtimeOptions = [
  { id: '', name: h.runtime.any, n: (state.kind ? counts[`kind:${state.kind}`] : counts.all) ?? runtimes.reduce((sum, r) => sum + r.n, 0) },
  ...runtimes.map((r) => ({ id: r.id, name: h.runtime.names[r.id] ?? r.id, n: r.n })),
].map((o) => ({ ...o, href: withQuery(path, state, { runtime: o.id || undefined }), chosen: (state.runtime ?? '') === o.id }));
// the rest of the state, kept when the form is sent without scripts (a new choice starts from the first page)
const kept = Object.entries({ q: state.q || undefined, kind: state.kind, tag: state.tag, sort: state.sort === 'popular' ? undefined : state.sort }).filter(
  (e): e is [string, string] => !!e[1],
);
const used = tags.filter((t) => t.count > 0).sort((a, b) => b.count - a.count);
// the most used first; the rest fold away, unless one of them is the chosen tag
const SHOWN = 16;
const shown = used.slice(0, SHOWN);
const folded = used.slice(SHOWN);
const open = folded.some((t) => t.id === state.tag);
---
<div class="filters">
  {runtimes.length > 1 && (
    <section class="filters__group">
      <h2 class="eyebrow">{h.runtime.label}</h2>
      <form class="pick" action={path} method="get">
        {kept.map(([name, value]) => <input type="hidden" name={name} value={value} />)}
        {/* Chrome draws the list itself (appearance: base-select), names and counts apart;
            elsewhere it is the system's, each option read as "name · count" */}
        <select class="pick__select" name="runtime" aria-label={h.runtime.label} data-pick>
          <button class="pick__button" type="button"><selectedcontent></selectedcontent></button>
          {runtimeOptions.map((o) => (
            <option value={o.id} selected={o.chosen} data-href={o.href}>
              <span class="pick__name">{o.name}</span><span class="pick__sep"> · </span><span class="pick__n">{n(o.n)}</span>
            </option>
          ))}
        </select>
        <noscript><button class="chip pick__apply" type="submit">{h.runtime.apply}</button></noscript>
      </form>
    </section>
  )}
  {used.length > 0 && (
    <section class="filters__group">
      <h2 class="eyebrow">{h.tags.label}</h2>
      <p class="tags">
        <a class="chip" href={withQuery(path, state, { tag: undefined })} aria-current={!state.tag ? 'true' : undefined}>{h.tags.all}</a>
        {shown.map((t) => (
          <a class="chip" href={withQuery(path, state, { tag: t.id })} aria-current={state.tag === t.id ? 'true' : undefined}>
            {t.name[lang]}
            <span class="chip__n">{n(t.count)}</span>
          </a>
        ))}
      </p>
      {folded.length > 0 && (
        <details class="tags__more" open={open}>
          <summary>{h.browse.allTags(used.length)}</summary>
          <p class="tags">
            {folded.map((t) => (
              <a class="chip" href={withQuery(path, state, { tag: t.id })} aria-current={state.tag === t.id ? 'true' : undefined}>
                {t.name[lang]}
                <span class="chip__n">{n(t.count)}</span>
              </a>
            ))}
          </p>
        </details>
      )}
    </section>
  )}
</div>

<style>
  .filters {
    display: grid;
    gap: var(--s-6);
  }

  .filters__group h2 {
    margin-bottom: var(--s-3);
  }

  /* The runtime list: a pill on the column's edges, like the search above,
     its words where a tag's are; open, a raised list of the same rows, the
     chosen one outlined as a chosen tag is. */
  .pick {
    position: relative;
  }

  .pick__select {
    width: 100%;
    height: 40px;
    padding: 0 38px 0 11px;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    background: var(--field);
    color: var(--corona);
    font: inherit;
    font-size: 14.5px;
    cursor: pointer;
    appearance: none;
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }

  .pick__select:hover {
    border-color: rgb(var(--corona-rgb) / 0.3);
  }

  .pick__select:focus-visible {
    outline: none;
    border-color: rgb(var(--bead-rgb) / 0.6);
    box-shadow: 0 0 0 4px rgb(var(--bead-rgb) / 0.12);
  }

  /* the system's list: a chevron of our own over the box */
  .pick::after {
    content: '';
    position: absolute;
    right: 17px;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-top: -4px;
    border-right: 1.3px solid var(--graphite);
    border-bottom: 1.3px solid var(--graphite);
    rotate: 45deg;
    pointer-events: none;
  }

  .pick__apply {
    margin-top: var(--s-3);
  }

  @supports (appearance: base-select) {
    .pick__select,
    .pick__select::picker(select) {
      appearance: base-select;
    }

    .pick::after {
      display: none;
    }

    .pick__select {
      display: flex;
      align-items: center;
      gap: var(--s-3);
      padding-inline: 11px 16px;
    }

    .pick__select:open {
      border-color: rgb(var(--bead-rgb) / 0.6);
    }

    /* the same chevron as the tags' fold */
    .pick__select::picker-icon {
      content: '';
      width: 6px;
      height: 6px;
      margin: -3px 2px 0 0;
      border-right: 1.3px solid var(--graphite);
      border-bottom: 1.3px solid var(--graphite);
      rotate: 45deg;
      transition:
        rotate 0.25s var(--ease-out),
        margin-top 0.25s var(--ease-out);
    }

    .pick__select:open::picker-icon {
      rotate: 225deg;
      margin-top: 3px;
    }

    .pick__button {
      display: flex;
      flex: 1;
      min-width: 0;
    }

    .pick selectedcontent,
    .pick option {
      display: flex;
      flex: 1;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--s-4);
      min-width: 0;
    }

    /* the names and counts stand apart; the dot is kept for screen readers */
    .pick__sep {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .pick__select::picker(select) {
      min-width: anchor-size(width);
      margin-block: 6px;
      padding: 4px;
      border: 1px solid var(--hairline-strong);
      border-radius: 20px;
      background: var(--raised);
      color: var(--corona);
      box-shadow: 0 13px 34px var(--shadow-deep);
    }

    .pick option {
      padding: 7px 12px;
      border-radius: 999px;
      color: var(--corona-64);
      cursor: pointer;
      transition:
        color 0.2s,
        background-color 0.2s;
    }

    .pick option::checkmark {
      display: none;
    }

    .pick option:hover,
    .pick option:focus-visible {
      outline: none;
      color: var(--corona);
      background: rgb(var(--corona-rgb) / 0.05);
    }

    .pick option:checked {
      color: var(--bead-hot);
      background: rgb(var(--bead-rgb) / 0.08);
      box-shadow: inset 0 0 0 1px rgb(var(--bead-rgb) / 0.5);
    }

    .pick option:checked .pick__n {
      color: var(--bead);
    }
  }

  .pick__name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pick__n {
    flex: none;
    font-family: var(--f-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    color: var(--graphite);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tags .chip {
    height: 28px;
    padding: 0 11px;
    font-size: 13px;
  }

  .tags__more {
    margin-top: var(--s-3);
  }

  .tags__more summary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: var(--s-2) 0;
    font-size: 13px;
    color: var(--corona-64);
    cursor: pointer;
    list-style: none;
  }

  .tags__more summary::-webkit-details-marker {
    display: none;
  }

  .tags__more summary::after {
    content: '';
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    rotate: 45deg;
    transition: rotate 0.25s var(--ease-out);
  }

  .tags__more[open] summary::after {
    rotate: 225deg;
    margin-top: 3px;
  }

  .tags__more summary:hover {
    color: var(--corona);
  }

  .tags__more .tags {
    margin-top: var(--s-3);
  }
</style>
