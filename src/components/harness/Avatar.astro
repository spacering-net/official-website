---
/**
 * A publisher's picture: its own, kept on this site (a GitHub account's
 * avatar, a domain's icon), or the first letter of its handle, tinted from
 * the handle so the same publisher always looks the same.
 */
interface Props {
  handle: string;
  avatar?: string | null;
  size?: number;
}
const { handle, avatar, size = 22 } = Astro.props;
let hash = 0;
for (const ch of handle) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const tint = `var(--tint-${(hash % 6) + 1})`;
const letter = ([...handle].find((c) => /[\p{L}\p{N}]/u.test(c)) ?? '?').toUpperCase();
---
{avatar ? (
  <img class="avatar" src={avatar} alt="" width={size} height={size} loading="lazy" decoding="async" style={`--size:${size}px`} />
) : (
  <span class="avatar avatar--letter" style={`--tint:${tint};--size:${size}px`} aria-hidden="true">{letter}</span>
)}

<style>
  .avatar {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: calc(var(--size) * 0.28);
    /* a picture as light as the page still has an edge */
    outline: 1px solid rgb(var(--corona-rgb) / 0.12);
    outline-offset: -1px;
    object-fit: cover;
  }

  .avatar--letter {
    outline-color: color-mix(in srgb, var(--tint) 45%, transparent);
    background: color-mix(in srgb, var(--tint) 12%, transparent);
    font-family: var(--f-mono);
    font-size: calc(var(--size) * 0.46);
    font-weight: 500;
    line-height: 1;
    color: var(--tint);
  }
</style>
