---
/**
 * A prompt in a gallery (the Prompts shelf, a publisher of prompts only): a
 * picture of what it makes on top, moving while it is pointed at (still for
 * touch screens and for those who ask for less motion), the prompt itself
 * below, who shared it and the model it was written for, and a button that
 * copies the whole prompt. Without a picture, the prompt's first words stand
 * in for one, so a row of cards still lines up.
 */
import Copy from './Copy.astro';
import { harnessDicts, pick } from '../../i18n/harness';
import type { Lang } from '../../i18n';
import { modelName, type ItemSummary } from '../../lib/harness';

interface Props {
  item: ItemSummary;
  lang: Lang;
}
const { item, lang } = Astro.props;
const h = harnessDicts[lang];
const p = item.prompt!;
const title = pick(item.title, lang) ?? item.name;
const model = modelName(p.model, true);
// what stands in for a picture: the prompt's first words
const words = p.excerpt.split(/\s+/).slice(0, 16).join(' ');
---
<li class="pc">
  <a class="pc__link" href={`${h.base}${item.ref}`} aria-label={title}>
    <span class:list={['pc__media', !p.cover && 'pc__media--words']}>
      {p.cover ? (
        <>
          <img class="pc__cover" src={p.cover} alt="" loading="lazy" decoding="async" />
          {p.motion && <img class="pc__motion" src={p.motion} alt="" loading="lazy" decoding="async" />}
        </>
      ) : (
        <>
          <svg class="pc__orbit" viewBox="0 0 200 120" fill="none" aria-hidden="true">
            <ellipse cx="150" cy="96" rx="92" ry="34" transform="rotate(-14 150 96)"></ellipse>
            <ellipse cx="150" cy="96" rx="58" ry="21" transform="rotate(-14 150 96)"></ellipse>
            <circle cx="96" cy="99" r="2.6"></circle>
          </svg>
          <span class="pc__words" aria-hidden="true">{words}</span>
        </>
      )}
      {(p.results > 1 || p.partial) && (
        <span class="pc__marks">
          {p.results > 1 && (
            <span class="pc__mark">
              <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 1.5v7l6-3.5z"></path></svg>
              {h.prompt.results(p.results)}
            </span>
          )}
          {p.partial && <span class="pc__mark">{h.prompt.partial}</span>}
        </span>
      )}
    </span>
    <span class="pc__body">
      <span class="pc__text"><span class="pc__quote">{p.excerpt}</span></span>
      <span class="pc__foot">
        {p.by && (
          <span class="pc__by">
            @{p.by}
            {p.results > 1 && <span class="pc__others">{h.prompt.others(p.results - 1)}</span>}
          </span>
        )}
        {model && <span class="badge pc__model">{model}</span>}
      </span>
    </span>
  </a>
  <Copy lang={lang} src={`/api/harness/v1/items/${item.ref}/prompt`} label={h.prompt.copy} class="pc__copy" />
</li>

<style>
  .pc {
    position: relative;
    display: flex;
    min-width: 0;
    transition: translate 0.4s var(--ease-out);
  }

  .pc:hover {
    translate: 0 -2px;
  }

  .pc__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 13px;
    background: var(--card-bg);
    transition:
      border-color 0.3s,
      box-shadow 0.4s;
  }

  .pc:hover .pc__link {
    border-color: rgb(var(--bead-rgb) / 0.4);
    box-shadow: var(--card-lift);
  }

  .pc__link:focus-visible {
    outline-offset: 2px;
  }

  /* --------------------------------------------------------- the picture */

  .pc__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
    background: var(--well);
  }

  .pc__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pc__cover {
    transition: scale 0.6s var(--ease-out);
  }

  .pc:hover .pc__cover {
    scale: 1.025;
  }

  /* the moving one loads only once it is shown: while pointed at, where pointing is how one looks */
  .pc__motion {
    display: none;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pc:hover .pc__motion,
    .pc__link:focus-visible .pc__motion {
      display: block;
    }
  }

  /* no picture: the prompt's first words, large, under an orbit */
  .pc__media--words {
    background:
      radial-gradient(120% 95% at 92% 112%, rgb(var(--bead-rgb) / 0.17), transparent 62%),
      radial-gradient(80% 70% at 0% 0%, rgb(var(--ion-rgb) / 0.07), transparent 60%),
      var(--well);
  }

  .pc__orbit {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 62%;
    stroke: rgb(var(--corona-rgb) / 0.16);
    stroke-width: 0.8;
  }

  .pc__orbit circle {
    fill: var(--bead);
    stroke: none;
  }

  .pc__words {
    position: absolute;
    inset: var(--s-5) var(--s-5) auto;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--f-display);
    font-size: 21px;
    font-weight: 300;
    line-height: 1.3;
    color: var(--corona);
    overflow-wrap: anywhere;
  }

  .pc__marks {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    display: flex;
    gap: 6px;
  }

  /* over any picture, in either theme */
  .pc__mark {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    background: rgb(5 5 7 / 0.62);
    color: #eceaf4;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .pc__mark svg {
    width: 8px;
    height: 8px;
    fill: currentColor;
  }

  /* ------------------------------------------------------------ the text */

  .pc__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--s-4) var(--s-5);
  }

  /* the prompt, quoted: room for four lines, written or not, the quote as long as it is */
  .pc__text {
    display: block;
    min-height: calc(4 * 1.6em);
    font-size: 14px;
    line-height: 1.6;
  }

  .pc__quote {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    padding-left: var(--s-3);
    border-left: 2px solid rgb(var(--bead-rgb) / 0.45);
    color: var(--corona-80);
    overflow-wrap: anywhere;
  }

  /* who shared it and its model, on one line beside the copy button; what does not fit fades */
  .pc__foot {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 30px;
    margin-top: auto;
    padding-top: var(--s-4);
    padding-right: 34px;
    box-sizing: content-box;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--corona-64);
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 62px), transparent calc(100% - 34px));
    mask-image: linear-gradient(90deg, #000 calc(100% - 62px), transparent calc(100% - 34px));
  }

  .pc__foot > * {
    flex: none;
  }

  .pc__by {
    display: inline-flex;
    gap: 6px;
  }

  .pc__others {
    color: var(--graphite);
  }

  .pc__model {
    height: 20px;
  }

  /* (the button is Copy's own, so it is reached as :global) */
  .pc :global(.pc__copy) {
    position: absolute;
    right: calc(var(--s-5) - 8px);
    bottom: var(--s-4);
    z-index: 1;
  }
</style>
