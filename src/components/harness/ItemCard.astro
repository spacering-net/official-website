---
/**
 * One item in a list: who publishes it, what it is called and does, its kind,
 * where it runs and its tags. Every card has the same rows at the same heights
 * (a title on one line, three lines of summary, one line of marks), so a row
 * of cards lines up. A prompt quotes itself in the title's and the summary's
 * four lines, and has a button that copies it (a gallery shows prompts as
 * PromptCard). An assistant has its seal before its title, and its model and
 * what it may touch among its marks (its own shelf shows AssistantCard).
 */
import { modelName, roleText, type ItemSummary, type TagInfo } from '../../lib/harness';
import { harnessDicts, pick } from '../../i18n/harness';
import type { Lang } from '../../i18n';
import { compact } from '../../lib/github';
import Avatar from './Avatar.astro';
import Copy from './Copy.astro';
import Seal from './Seal.astro';
import Access from './Access.astro';

interface Props {
  item: ItemSummary;
  lang: Lang;
  tags: Map<string, TagInfo>;
}
const { item, lang, tags } = Astro.props;
const h = harnessDicts[lang];
const title = pick(item.title, lang) ?? item.name;
const prompt = item.kind === 'prompt' ? item.prompt : undefined;
const assistant = item.kind === 'assistant' ? item.assistant : undefined;
const summary = assistant ? roleText(pick(item.summary, lang) ?? assistant.role) : pick(item.summary, lang);
const model = assistant && (assistant.model === 'inherit' ? h.assistant.inherit : modelName(assistant.model, true));
---
<li class:list={['card', prompt && 'card--prompt', assistant && 'card--assistant']}>
  <a class="card__link" href={`${h.base}${item.ref}`} aria-label={prompt ? title : undefined}>
    <span class="card__top">
      <Avatar handle={item.publisher.handle} avatar={item.publisher.avatar} size={22} />
      <span class="card__pub">{item.publisher.handle}</span>
      {!prompt && item.repoStars !== null && item.repoStars > 0 && (
        <span class="card__stars" title={h.card.stars}><span aria-hidden="true">★</span> {compact(item.repoStars)}</span>
      )}
    </span>
    {prompt ? (
      <span class="card__quote"><span class="card__quote-text">{prompt.excerpt}</span></span>
    ) : (
      <>
        {assistant ? (
          <span class="card__title card__title--seal" title={title}>
            <Seal seed={item.ref} title={title} color={assistant.color} size={22} />
            <span class="card__name">{title}</span>
          </span>
        ) : (
          <span class="card__title" title={title}>{title}</span>
        )}
        <span class="card__summary">{summary}</span>
      </>
    )}
    <span class="card__foot">
      <span class="badge badge--kind">{h.kind[item.kind]}</span>
      {item.risk !== 'low' && (
        <span class={`badge badge--risk-${item.risk}`}><span class={`risk-dot risk-dot--${item.risk}`}></span>{h.item.risk[item.risk]}</span>
      )}
      {item.status === 'listed' && <span class="badge badge--listed">{h.card.listed}</span>}
      {prompt ? (
        <>
          {prompt.model && <span class="card__runtime">{modelName(prompt.model, true)}</span>}
          {prompt.results > 1 && <span class="card__runtime">{h.prompt.results(prompt.results)}</span>}
        </>
      ) : assistant ? (
        <>
          {model && <span class="card__runtime">{model}</span>}
          <Access access={assistant.access} lang={lang} compact />
        </>
      ) : (
        <span class="card__runtime">{h.runtime.names[item.runtime] ?? item.runtime}</span>
      )}
      {item.tags.slice(0, 3).map((t) => <span class="card__tag">{tags.get(t)?.name[lang] ?? t}</span>)}
    </span>
  </a>
  {prompt && <Copy lang={lang} src={`/api/harness/v1/items/${item.ref}/prompt`} label={h.prompt.copy} class="card__copy" />}
</li>

<style>
  .card {
    position: relative;
    display: flex;
    min-width: 0;
    transition: translate 0.4s var(--ease-out);
  }

  /* the card lifts as a whole, with a button laid over it */
  .card:hover {
    translate: 0 -2px;
  }

  .card__link {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--s-5);
    border: 1px solid var(--hairline);
    border-radius: 13px;
    background: var(--card-bg);
    transition:
      border-color 0.3s,
      box-shadow 0.4s;
  }

  .card:hover .card__link {
    border-color: rgb(var(--bead-rgb) / 0.4);
    box-shadow: var(--card-lift);
  }

  .card__link:focus-visible {
    outline-offset: 2px;
    border-radius: 13px;
  }

  .card__top {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 22px;
    min-width: 0;
  }

  .card__pub {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--corona-64);
  }

  .card__stars {
    flex: none;
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--graphite);
  }

  .card__title {
    margin-top: var(--s-4);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 17px;
    line-height: 24px;
    color: var(--corona);
  }

  .card__summary {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* three lines, written or not */
    min-height: calc(3 * 1.55em);
    margin-top: var(--s-2);
    font-size: 14px;
    line-height: 1.55;
    color: var(--corona-64);
  }

  /* one line of marks; what does not fit fades out at the edge */
  .card__foot {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: 22px;
    margin-top: auto;
    padding-top: var(--s-4);
    box-sizing: content-box;
    overflow: hidden;
    white-space: nowrap;
    font-size: 12.5px;
    line-height: 1;
    color: var(--graphite);
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent);
    mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent);
  }

  .card__foot > * {
    flex: none;
  }

  .card__runtime {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--corona-64);
  }

  .card__tag::before {
    content: '#';
    margin-right: 1px;
    color: rgb(var(--corona-rgb) / 0.3);
  }

  /* ---------------------------------------------------------- an assistant */

  /* its seal before its title, on the title's line */
  .card__title--seal {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .card__name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* -------------------------------------------------------------- a prompt */

  /* room on the first line for the copy button */
  .card--prompt .card__top {
    padding-right: 30px;
  }

  /* the prompt, quoted in the four lines a title and its summary take (the box as tall, the quote as long as it is) */
  .card__quote {
    display: block;
    height: calc(24px + var(--s-2) + 4.65em);
    margin-top: var(--s-4);
    font-size: 14px;
  }

  .card__quote-text {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    padding-left: var(--s-3);
    border-left: 2px solid rgb(var(--bead-rgb) / 0.45);
    line-height: calc((24px + var(--s-2) + 4.65em) / 4);
    color: var(--corona-80);
    overflow-wrap: anywhere;
  }

  /* (the button is Copy's own, so it is reached as :global) */
  .card :global(.card__copy) {
    position: absolute;
    top: calc(var(--s-5) - 4px);
    right: calc(var(--s-5) - 8px);
    z-index: 1;
  }
</style>
