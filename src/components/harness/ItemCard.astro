---
/** One item in a list: who publishes it, what it is called and does, its kind, where it runs and its tags. */
import type { ItemSummary, TagInfo } from '../../lib/harness';
import { harnessDicts, pick } from '../../i18n/harness';
import type { Lang } from '../../i18n';
import { compact } from '../../lib/github';
import Monogram from './Monogram.astro';

interface Props {
  item: ItemSummary;
  lang: Lang;
  tags: Map<string, TagInfo>;
}
const { item, lang, tags } = Astro.props;
const h = harnessDicts[lang];
const title = pick(item.title, lang) ?? item.name;
const summary = pick(item.summary, lang);
---
<li class="card">
  <a class="card__link" href={`${h.base}${item.ref}`}>
    <span class="card__top">
      <Monogram handle={item.publisher.handle} size={22} />
      <span class="card__pub">{item.publisher.handle}</span>
      {item.repoStars !== null && item.repoStars > 0 && (
        <span class="card__stars" title={h.card.stars}><span aria-hidden="true">★</span> {compact(item.repoStars)}</span>
      )}
    </span>
    <span class="card__title">{title}</span>
    {summary && <span class="card__summary">{summary}</span>}
    <span class="card__foot">
      <span class="badge badge--kind">{h.kind[item.kind]}</span>
      {item.risk !== 'low' && (
        <span class={`badge badge--risk-${item.risk}`}><span class={`risk-dot risk-dot--${item.risk}`}></span>{h.item.risk[item.risk]}</span>
      )}
      {item.status === 'listed' && <span class="badge badge--listed">{h.card.listed}</span>}
      <span class="card__runtime">{h.runtime.names[item.runtime] ?? item.runtime}</span>
      {item.tags.slice(0, 2).map((t) => <span class="card__tag">{tags.get(t)?.name[lang] ?? t}</span>)}
    </span>
  </a>
</li>

<style>
  .card {
    display: flex;
    min-width: 0;
  }

  .card__link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    width: 100%;
    padding: var(--s-5) var(--s-5) var(--s-4);
    border: 1px solid var(--hairline);
    border-radius: 13px;
    background: linear-gradient(180deg, rgb(236 234 244 / 0.03), rgb(236 234 244 / 0.008));
    transition:
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.4s,
      translate 0.4s var(--ease-out);
  }

  .card__link:hover {
    border-color: rgb(255 217 160 / 0.38);
    background-color: rgb(236 234 244 / 0.02);
    box-shadow: 0 22px 44px -28px rgb(255 217 160 / 0.4);
    translate: 0 -2px;
  }

  .card__link:focus-visible {
    outline-offset: 2px;
    border-radius: 13px;
  }

  .card__top {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
  }

  .card__pub {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--corona-64);
  }

  .card__stars {
    flex: none;
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--graphite);
  }

  .card__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: var(--s-1);
    font-size: 17.5px;
    line-height: 1.3;
    color: var(--corona);
    overflow-wrap: anywhere;
  }

  .card__summary {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.55;
    color: var(--corona-64);
  }

  .card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px var(--s-3);
    margin-top: auto;
    padding-top: var(--s-3);
    font-size: 12.5px;
    color: var(--graphite);
  }

  .card__runtime {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--corona-64);
  }

  .card__tag::before {
    content: '#';
    margin-right: 1px;
    color: rgb(139 138 153 / 0.6);
  }
</style>
