---
/**
 * The console's section marks: hairline drawings, 20 units square, in the
 * text's colour. Overview a dashboard's tiles, the log a clock turned back,
 * backups a cloud taking something up, Relay a signal reaching out both ways.
 */
import type { ConsoleSection } from '../../i18n/console';

interface Props {
  /** a section's, what a row is (a desktop app, a Web service, a browser), or what a button does */
  name: ConsoleSection | 'desktop' | 'web' | 'browser' | 'camera' | 'trash' | 'edit' | 'signout';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class:list={['console-icon', className]} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'overview' && (
    <>
      <rect x="3" y="3" width="6" height="7.5" rx="1.6"></rect>
      <rect x="11" y="3" width="6" height="4.5" rx="1.6"></rect>
      <rect x="3" y="12.5" width="6" height="4.5" rx="1.6"></rect>
      <rect x="11" y="9.5" width="6" height="7.5" rx="1.6"></rect>
    </>
  )}
  {name === 'desktop' && (
    <>
      <rect x="2.5" y="4" width="15" height="9.5" rx="1.3"></rect>
      <path d="M7 16.5h6M10 13.5v3"></path>
    </>
  )}
  {name === 'web' && (
    <>
      <circle cx="10" cy="10" r="7.2"></circle>
      <path d="M2.8 10h14.4M10 2.8c2 2 3 4.4 3 7.2s-1 5.2-3 7.2c-2-2-3-4.4-3-7.2s1-5.2 3-7.2z"></path>
    </>
  )}
  {name === 'browser' && (
    <>
      <rect x="2.5" y="3.5" width="15" height="13" rx="1.6"></rect>
      <path d="M2.5 7.2h15M5 5.4h.01M7 5.4h.01"></path>
    </>
  )}
  {name === 'camera' && (
    <>
      <path d="M2.8 7.3c0-.9.7-1.6 1.6-1.6h2.1l1.3-1.9h4.4l1.3 1.9h2.1c.9 0 1.6.7 1.6 1.6v7.3c0 .9-.7 1.6-1.6 1.6H4.4c-.9 0-1.6-.7-1.6-1.6z"></path>
      <circle cx="10" cy="10.7" r="2.9"></circle>
    </>
  )}
  {name === 'trash' && <path d="M3.6 5.6h12.8M8 5.6V3.9h4v1.7M5.3 5.6l.7 10.3c.1.9.8 1.5 1.6 1.5h4.8c.8 0 1.5-.6 1.6-1.5l.7-10.3M8.4 8.9v5.2M11.6 8.9v5.2"></path>}
  {name === 'edit' && <path d="M13.2 3.7a1.6 1.6 0 0 1 2.3 0l.8.8a1.6 1.6 0 0 1 0 2.3l-8.8 8.8-3.6.9.9-3.6zM11.7 5.2l3.1 3.1"></path>}
  {name === 'signout' && <path d="M8.5 3.5H5.3c-1 0-1.8.8-1.8 1.8v9.4c0 1 .8 1.8 1.8 1.8h3.2M12.6 6.4L16.2 10l-3.6 3.6M16.2 10H8"></path>}
  {name === 'clients' && (
    <>
      <rect x="2.5" y="4.5" width="11" height="8" rx="1.2"></rect>
      <path d="M6 16h4M8 12.5V16"></path>
      <rect x="14.5" y="8" width="3.5" height="8" rx="1"></rect>
    </>
  )}
  {name === 'security' && (
    <>
      <path d="M10 2.6l5.8 2.2v4.5c0 3.8-2.5 6.5-5.8 8.1-3.3-1.6-5.8-4.3-5.8-8.1V4.8z"></path>
      <path d="M7.6 10l1.7 1.7 3.2-3.4"></path>
    </>
  )}
  {name === 'activity' && <path d="M3.4 10a6.6 6.6 0 1 0 1.93-4.67L3.4 7.2M3.4 3.9v3.3h3.3M10 6.7V10l2.4 1.5"></path>}
  {name === 'card' && (
    <>
      <rect x="2.5" y="5" width="15" height="10" rx="1.8"></rect>
      <circle cx="7" cy="10" r="2"></circle>
      <path d="M11 9h4M11 11.5h2.5"></path>
    </>
  )}
  {name === 'backups' && <path d="M6 15.6a3.6 3.6 0 0 1-.5-7.15 4.8 4.8 0 0 1 9.2.05A3.6 3.6 0 0 1 14 15.6M10 17v-6.4M7.7 12.9L10 10.6l2.3 2.3"></path>}
  {name === 'relay' && (
    <>
      <circle cx="10" cy="10" r="1.6"></circle>
      <path d="M6.7 6.7a4.7 4.7 0 0 0 0 6.6M13.3 6.7a4.7 4.7 0 0 1 0 6.6M4.2 4.2a8.2 8.2 0 0 0 0 11.6M15.8 4.2a8.2 8.2 0 0 1 0 11.6"></path>
    </>
  )}
</svg>
