---
/**
 * The foot of every page but the homepage (whose finale has its own): the
 * HUD's pages, which narrow screens reach from here, then Codeg's docs and
 * GitHub.
 */
import Logo from './Logo.astro';
import FootLine from './FootLine.astro';
import { SITE } from '../config';
import { PAGES, type Dict } from '../i18n';

interface Props {
  t: Dict;
  /** this page in the other language */
  alternate: string;
}
const { t, alternate } = Astro.props;
const docs = t.menu.external[0];
const github = t.menu.external[1];
const pages = [
  { name: t.nav.space, href: `${t.path}${PAGES.space}` },
  { name: t.nav.assistant, href: `${t.path}${PAGES.assistant}` },
  { name: 'Harness', href: `${t.path}${PAGES.harness}` },
  { name: t.nav.openSource, href: `${t.path}${PAGES['open-source']}` },
];
---
<footer class="page-foot">
  <div class="page-foot__inner">
    <div class="page-foot__top">
      <a class="brand" href={t.path} aria-label={t.nav.home}>
        <Logo class="brand__mark" />
        <span class="brand__word" aria-hidden="true">SpaceRing</span>
      </a>
      <nav class="page-foot__links" aria-label={t.menu.destinations}>
        {pages.map((p) => <a href={p.href}>{p.name}</a>)}
        <a href={SITE.codeg.docs} target="_blank" rel="noopener">{docs.name} <span aria-hidden="true">↗</span></a>
        <a href={SITE.orgUrl} target="_blank" rel="noopener">{github.name} <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
    {/* the languages, the theme and the small print: the same line ends the orbit menu */}
    <FootLine t={t} alternate={alternate} />
  </div>
</footer>

<style>
  .page-foot {
    margin-top: var(--s-8);
    border-top: 1px solid var(--hairline);
  }

  .page-foot__inner {
    display: grid;
    gap: var(--s-5);
    padding: var(--s-6) var(--page-pad) var(--s-5);
  }

  /* the brand, and the links on the right */
  .page-foot__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5) var(--s-6);
  }

  .page-foot__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2) var(--s-5);
    margin-left: auto;
    font-size: 14px;
    color: var(--corona-64);
  }

  .page-foot__links a {
    transition: color 0.3s;
  }

  .page-foot__links a:hover {
    color: var(--corona);
  }

  @media (max-width: 760px) {
    .page-foot__inner {
      gap: var(--s-4);
    }

    .page-foot__top {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-4);
    }

    .page-foot__links {
      justify-content: flex-start;
      margin-left: 0;
    }
  }
</style>
