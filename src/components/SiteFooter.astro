---
/** The foot of every page but the homepage (whose finale has its own). */
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { SITE } from '../config';
import { PRODUCT_PAGES, type Dict } from '../i18n';

interface Props {
  t: Dict;
  /** this page in the other language */
  alternate: string;
}
const { t, alternate } = Astro.props;
const docs = t.menu.external[0];
const github = t.menu.external[1];
---
<footer class="page-foot">
  <div class="page-foot__inner">
    <a class="brand" href={t.path} aria-label={t.nav.home}>
      <Logo class="brand__mark" />
      <span class="brand__word" aria-hidden="true">SpaceRing</span>
    </a>
    <nav class="page-foot__links" aria-label={t.menu.destinations}>
      <a href={`${t.path}${PRODUCT_PAGES.harness}`}>Harness</a>
      <a href={SITE.codeg.docs} target="_blank" rel="noopener">{docs.name} <span aria-hidden="true">↗</span></a>
      <a href={SITE.orgUrl} target="_blank" rel="noopener">{github.name} <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="page-foot__prefs">
      <LangSwitch t={t} href={alternate} />
      <ThemeSwitch t={t} />
    </div>
    <p class="page-foot__legal">
      <span>© {new Date().getFullYear()} SpaceRing · spacering.net</span>
      <a href={`${t.path}privacy/`}>{t.open.privacy}</a>
      <a href={`${t.path}terms/`}>{t.open.terms}</a>
    </p>
  </div>
</footer>

<style>
  .page-foot {
    margin-top: var(--s-8);
    border-top: 1px solid var(--hairline);
  }

  /* the brand and the links, then the languages, the theme and the small print */
  .page-foot__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-5) var(--s-6);
    padding: var(--s-6) var(--page-pad) var(--s-5);
  }

  .page-foot__prefs {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .page-foot__links,
  .page-foot__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2) var(--s-5);
  }

  .page-foot__links {
    font-size: 14px;
    color: var(--corona-64);
  }

  .page-foot__legal {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--graphite);
  }

  .page-foot a {
    transition: color 0.3s;
  }

  .page-foot__links a:hover,
  .page-foot__legal a:hover {
    color: var(--corona);
  }

  @media (max-width: 760px) {
    .page-foot__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }

    .page-foot__links,
    .page-foot__legal {
      justify-content: flex-start;
    }
  }
</style>
