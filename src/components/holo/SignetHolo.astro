---
import type { Dict } from '../../i18n';
import { MARK_BAND, MARK_CRESCENT } from '../mark';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const h = t.signet.holo;
---
<div class="holo" aria-hidden="true">
  <span class="holo__tag">{t.status.preview}</span>
  <div class="holo__bar"><span>{h.label}</span><span>{h.summary}</span></div>
  <ul>
    {h.grants.map((g) => (
      <li class="grant" data-expired={g.expired ? '' : undefined}>
        <span class="grant__who">{g.who}</span>
        <span class="grant__scope">{g.scope}</span>
        <span class="grant__access">{g.access}</span>
        <span class="grant__ttl">{g.expires}</span>
        <span class="grant__revoke">{g.expired ? '' : h.revoke}</span>
      </li>
    ))}
  </ul>
  <div class="holo__foot audit">
    <svg class="seal" viewBox="0 0 512 512">
      <circle class="seal__rim" cx="256" cy="256" r="236"></circle>
      <g transform="translate(97 97) scale(0.62)">
        <path fill-rule="evenodd" d={MARK_BAND}></path>
        <path d={MARK_CRESCENT}></path>
      </g>
    </svg>
    <span>{h.audit}</span>
  </div>
</div>
