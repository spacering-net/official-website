---
import type { Dict } from '../../i18n';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const h = t.space.holo;
---
<div class="holo" aria-hidden="true">
  <span class="holo__tag">{t.status.preview}</span>
  <div class="holo__bar"><span>{h.label}</span><span class="holo__lock">{h.encrypted}</span></div>
  <p class="query">
    <svg class="query__icon" viewBox="0 0 12 12"><circle cx="5" cy="5" r="3.6"></circle><path d="M7.7 7.7L11 11"></path></svg>
    <span>{h.query}<span class="caret"></span></span>
  </p>
  <ul>
    {h.hits.map((hit, i) => (
      <li class="hit" style={`--i:${i}`}>
        <span class="hit__kind">{hit.kind}</span>
        <span class="hit__name">{hit.name}</span>
        <span class="hit__from">{hit.from}</span>
      </li>
    ))}
  </ul>
  <div class="holo__foot usage">
    <span class="usage__bar">{h.usage.map((u, i) => <i style={`--w:${u.share};--o:${(1 - i * 0.17).toFixed(2)}`}></i>)}</span>
    <span class="usage__legend">{h.usage.map((u) => <span><b>{u.value}</b> {u.label}</span>)}</span>
  </div>
</div>
