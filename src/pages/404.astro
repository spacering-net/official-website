---
/**
 * Served for any address that is not a page (Cloudflare serves the nearest
 * 404.html: this one, or zh/404.html under /zh/), and by the Worker for
 * Harness addresses with nothing behind them (api/index.ts).
 */
import Page from '../layouts/Page.astro';
import NotFound from '../components/NotFound.astro';
import { dicts } from '../i18n';

const t = dicts.en;
---
<Page lang="en" title={t.notFound.title} description={t.notFound.lede} paths={{ en: '/', zh: '/zh/' }} noindex>
  <NotFound t={t} />
</Page>
