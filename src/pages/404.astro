---
/**
 * Served for any address that is not a page (Cloudflare: `not_found_handling`
 * in wrangler.jsonc). Standalone and light, with no scene and no intro; in both
 * languages, since a wrong address says nothing about the reader's.
 */
import '@fontsource-variable/jost';
import '@fontsource/ibm-plex-mono/400.css';
import Logo from '../components/Logo.astro';
import { dicts } from '../i18n';

const { en, zh } = dicts;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 · SpaceRing</title>
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  </head>
  <body>
    <main>
      <Logo class="mark" />
      <p class="code">404</p>
      <h1>This page is not in the ring.</h1>
      <p class="zh" lang="zh-CN">这一页不在戒指里。</p>
      <nav>
        <a href={en.path}>SpaceRing home</a>
        <a href={zh.path} lang="zh-CN">中文首页</a>
      </nav>
    </main>
  </body>
</html>

<!-- global: the mark is drawn inside the Logo component, beyond this page's scope -->
<style is:global>
  body {
    margin: 0;
    min-height: 100svh;
    display: grid;
    place-items: center;
    background: #050507;
    color: #eceaf4;
    font-family: 'Jost Variable', 'Jost', 'PingFang SC', 'HarmonyOS Sans SC', 'Microsoft YaHei', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main {
    padding: 34px 21px;
    text-align: center;
  }

  .mark {
    width: 55px;
    height: 55px;
    fill: #eceaf4;
  }

  .code,
  nav a {
    font-family: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
  }

  .code {
    margin: 21px -0.42em 0 0;
    font-size: 12px;
    letter-spacing: 0.42em;
    color: #ffd9a0;
  }

  h1 {
    margin: 21px 0 0;
    font-weight: 300;
    font-size: clamp(26px, 4vw, 34px);
    letter-spacing: -0.01em;
  }

  .zh {
    margin: 8px 0 0;
    font-size: 17px;
    letter-spacing: 0.04em;
    color: rgb(236 234 244 / 0.64);
  }

  nav {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 21px;
  }

  nav a {
    padding: 8px 0;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(236 234 244 / 0.64);
    border-bottom: 1px solid rgb(236 234 244 / 0.2);
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  nav a:hover,
  nav a:focus-visible {
    color: #eceaf4;
    border-color: #ffd9a0;
  }

  nav a:focus-visible {
    outline: 1px solid #ffd9a0;
    outline-offset: 4px;
  }
</style>
